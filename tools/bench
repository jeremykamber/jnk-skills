#!/usr/bin/env python3
"""bench — does the workflow keep the code correct, clean and cheap as it grows?

The instrument follows SlopCodeBench (arXiv:2603.24755), which measures what
single-shot benchmarks hide: an agent extending **its own** code across
checkpoints, and the quality of that code as it accumulates. Two signals, both
shares in [0, 1], so a 200-line repository and a 20,000-line one compare:

    erosion    the share of complexity mass held by functions with CC > 10.
               mass(f) = CC(f) * sqrt(SLOC(f)), the paper's equation 2, so a
               function that quietly grows branches accumulates mass faster than
               one that is merely long. Equation 3, with the paper's cutoff.
    verbosity  the share of source lines that are structurally duplicated or
               flagged redundant. This is a subset of the paper's ast-grep
               pattern set: structural duplicates, stub bodies, and TODO/FIXME
               markers. Named here because an approximate metric that does not
               say what it approximates is a number nobody can argue with.

A *series* is a list of feature checkpoints applied in order to one growing
repository. Each checkpoint is graded on the paper's ladder:

    strict    every test passes, including the regressions earlier checkpoints
              carried forward — the code still works
    isolated  this checkpoint's own behaviour passes, ignoring regressions —
              the work landed even though something earlier broke

Solve rates use a fixed denominator: a checkpoint the agent never produced code
for counts as unsolved. Quality is measured only where code exists, never imputed
for a run that crashed.

PRIORITY. Arms are compared lexicographically, in this order and no other:

    1. strict solve rate   (correctness — does it work)
    2. erosion             (does the design survive the change)
    3. verbosity           (does the code accumulate junk)
    4. tokens              (what it cost)

Exit 1 when the workflow is worse than the baseline on the first axis that
differs. A cheaper arm that is less correct has not won.

Usage:
    bench --run ticket-desk --arm baseline --arm workflow
    ./tools/bench --self-test
    ./tools/bench --report
"""

from __future__ import annotations

import argparse
import json
import math
import os
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass, field
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
BENCH = ROOT / "bench"
RESULTS = BENCH / "results"
SOURCE_EXT = {".py", ".ts", ".tsx", ".js", ".jsx", ".mjs", ".cjs"}
SKIP_DIRS = {".git", "node_modules", ".venv", "venv", "__pycache__", ".bench",
             "coverage", "dist", "build", ".mypy_cache", ".pytest_cache", ".ruff_cache"}
HIGH_CC = 10       # SCBench eq. 3, following Radon's default
DUP_WINDOW = 5
TEST_PATH = re.compile(r"(^|/)(tests?|__tests__|spec)/|(^|/)(test_|conftest)|(_test|\.test|\.spec)\.")
TODO = re.compile(r"(TODO|FIXME|XXX)", re.IGNORECASE)
STUB_BODY = re.compile(r"^\s*(pass|\.\.\.)\s*$")

PROMPT_PREFIX = {
    "bare": "",
    "baseline": "",
    # What a person who installed this workflow would type. The beats are
    # user-invoked by design — choosing one is the user's judgement, and a
    # headless run has no user — so the benchmark carries the choice a competent
    # user would have made for a one-file change and measures what follows.
    "workflow": (
        "Work only inside the current directory; never write outside it.\n"
        "Run the jnk-oneshot beat for this change: read {skills}/jnk-oneshot/"
        "SKILL.md and follow it. Stop at its gate.\n\n"
    ),
}


# --------------------------------------------------------------------------
# quality: erosion and verbosity
# --------------------------------------------------------------------------


@dataclass
class Quality:
    loc: int = 0
    files: int = 0
    test_files: int = 0
    functions: int = 0
    total_mass: float = 0.0
    eroded_mass: float = 0.0
    erosion: float = 0.0
    dup_lines: int = 0
    flagged_lines: int = 0
    verbosity: float = 0.0

    def as_dict(self) -> dict:
        return {**self.__dict__, "total_mass": round(self.total_mass, 2),
                "eroded_mass": round(self.eroded_mass, 2)}


def source_files(repo: Path) -> tuple[list[Path], list[Path]]:
    """Source and test files, split. Tests are counted, never scored: a test
    suite is not slop, and a benchmark that punishes tests teaches the wrong
    lesson."""
    src: list[Path] = []
    tests: list[Path] = []
    for path in repo.rglob("*"):
        if not path.is_file() or path.suffix not in SOURCE_EXT:
            continue
        if any(part in SKIP_DIRS for part in path.parts):
            continue
        rel = path.relative_to(repo).as_posix()
        (tests if TEST_PATH.search(rel) else src).append(path)
    return src, tests


def _lines(path: Path) -> list[str]:
    try:
        return path.read_text(encoding="utf-8", errors="ignore").splitlines()
    except OSError:
        return []


def duplicated_lines(files: list[Path]) -> int:
    """Lines inside a 5-line window that appears more than once in the tree.

    Whitespace- and blank-stripped, comments removed, so reformatting is not
    duplication. A window with fewer than three distinct lines is boilerplate
    (braces, `pass`, argument lists) and is skipped.
    """
    windows: dict[tuple[str, ...], int] = {}
    for path in files:
        lines = [line.strip() for line in _lines(path)]
        lines = [line for line in lines if line and not line.startswith(("#", "//", "*", "/*"))]
        for i in range(len(lines) - DUP_WINDOW + 1):
            window = tuple(lines[i:i + DUP_WINDOW])
            if len(set(window)) < 3:
                continue
            windows[window] = windows.get(window, 0) + 1
    return sum(DUP_WINDOW * (count - 1) for count in windows.values() if count > 1)


def flagged_lines(files: list[Path]) -> int:
    """Lines this instrument calls redundant, as a documented subset of the
    paper's pattern set: a stub body, a TODO/FIXME marker, and an import this
    same file never uses by name."""
    flagged = 0
    for path in files:
        lines = _lines(path)
        if not lines:
            continue
        for index, line in enumerate(lines):
            if TODO.search(line) or STUB_BODY.match(line):
                flagged += 1
        text = "\n".join(lines)
        for match in re.finditer(r"^\s*(?:import\s+([\w.]+)|from\s+[\w.]+\s+import\s+([^\n(]+))", text, re.MULTILINE):
            names = match.group(1) or match.group(2) or ""
            for name in re.split(r"[,\s]+", names.strip("() ")):
                name = name.split(" as ")[-1].strip()
                if not name or name == "*":
                    continue
                if len(re.findall(rf"\b{re.escape(name)}\b", text)) < 2:
                    flagged += 1
    return flagged


def measure(repo: Path, only: list[Path] | None = None) -> Quality:
    """Quality of the workspace, or of `only` when the workspace came seeded.

    A seeded real repository carries code nobody touched this checkpoint, and its
    erosion is a constant: measuring the whole tree would drown the delta in it.
    The paper can measure the workspace because its workspaces start empty.
    """
    import lizard  # a workflow dependency; install.sh checks it

    src, tests = source_files(repo)
    if only is not None:
        keep = {p.resolve() for p in only}
        src = [p for p in src if p.resolve() in keep]
    quality = Quality(files=len(src), test_files=len(tests))
    for path in src:
        try:
            info = lizard.analyze_file(str(path))
        except Exception:
            continue
        quality.loc += info.nloc
        for fn in info.function_list:
            quality.functions += 1
            mass = fn.cyclomatic_complexity * math.sqrt(max(fn.nloc, 1))
            quality.total_mass += mass
            if fn.cyclomatic_complexity > HIGH_CC:
                quality.eroded_mass += mass
    quality.erosion = round(quality.eroded_mass / quality.total_mass, 4) if quality.total_mass else 0.0
    if src:
        quality.dup_lines = duplicated_lines(src)
        quality.flagged_lines = flagged_lines(src)
    lines = max(quality.loc, 1)
    quality.verbosity = round(min((quality.dup_lines + quality.flagged_lines) / lines, 1.0), 4)
    return quality


# --------------------------------------------------------------------------
# the run
# --------------------------------------------------------------------------


@dataclass
class Checkpoint:
    task: str
    strict: bool
    isolated: bool
    detail: str
    produced: bool
    seconds: float
    timed_out: bool
    tokens: int
    cost: float
    tool_calls: int
    turns: int
    quality: dict = field(default_factory=dict)

    def as_dict(self) -> dict:
        return {**self.__dict__, "quality": self.quality}


def arm_flags(arm: str) -> list[str]:
    base = ["--no-session", "--no-skills", "--no-context-files"]
    if arm == "bare":
        return base
    if arm == "baseline":
        return base + ["--append-system-prompt", str(BENCH / "arms" / "baseline.md")]
    if arm == "workflow":
        flags = list(base) + ["--append-system-prompt", str(ROOT / "AGENTS.md")]
        for skill in sorted((ROOT / "skills").glob("jnk-*/SKILL.md")):
            flags += ["--skill", str(skill.parent)]
        return flags
    raise SystemExit(f"bench: unknown arm '{arm}' (bare, baseline, workflow)")


def usage_from_events(raw: str) -> tuple[int, float, int, int]:
    """Total tokens, cost, tool calls, turns — from the harness's JSONL."""
    tokens, cost, calls, turns = 0, 0.0, 0, 0
    for line in raw.splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            event = json.loads(line)
        except json.JSONDecodeError:
            continue
        message = event.get("message") or {}
        if event.get("type") != "message_end" or message.get("role") != "assistant":
            continue
        turns += 1
        usage = message.get("usage") or {}
        tokens += int(usage.get("totalTokens") or 0)
        cost += float((usage.get("cost") or {}).get("total") or 0.0)
        calls += json.dumps(message.get("content") or "").count('"toolCall"')
    return tokens, cost, calls, turns


def run_agent(agent: str, arm: str, repo: Path, prompt: str, timeout: int, log: Path) -> tuple[str, float, bool]:
    """Run one agent turn, killing the whole process group on a timeout.

    `shell=True` makes the agent a grandchild: killing the shell leaves it
    running, still writing to the repo while the verifier reads it. That is how a
    timed-out checkpoint scores a pass it did not earn.
    """
    import shlex

    flags = arm_flags(arm)
    # A real repository ships its own AGENTS.md. Both arms get it: the project's
    # rules are part of the environment, not part of either instruction set.
    project_rules = repo / "AGENTS.md"
    if project_rules.is_file():
        text = project_rules.read_text(errors="ignore")
        if "/Developer/repos/" in text or "/Users/" in text:
            print(f"  note: {project_rules.name} names absolute paths; not passing it in",
                  file=sys.stderr)
        else:
            flags += ["--append-system-prompt", str(project_rules)]
    cmd = f"{agent} {' '.join(shlex.quote(a) for a in flags)} {shlex.quote(prompt)}"
    started = time.time()
    proc = subprocess.Popen(cmd, shell=True, cwd=repo, stdout=subprocess.PIPE,
                            stderr=subprocess.PIPE, text=True, start_new_session=True)
    timed_out = False
    try:
        out, err = proc.communicate(timeout=timeout)
    except subprocess.TimeoutExpired:
        timed_out = True
        try:
            os.killpg(os.getpgid(proc.pid), signal.SIGKILL)
        except (ProcessLookupError, PermissionError):
            proc.kill()
        out, err = proc.communicate()
    raw = out or ""
    if timed_out:
        raw += "\n" + json.dumps({"type": "error", "message": f"timed out after {timeout}s"}) + "\n"
    elif proc.returncode != 0 and not raw:
        raw = json.dumps({"type": "error", "message": (err or "")[-4000:]}) + "\n"
    log.write_text(raw, encoding="utf-8")
    return raw, time.time() - started, timed_out


def git(repo: Path, *args: str) -> None:
    subprocess.run(["git", *args], cwd=repo, capture_output=True, text=True)


def verify(repo: Path, script: Path, level: str) -> tuple[bool, str]:
    """The acceptance check, run from a temp copy outside the repo so the agent
    can neither read it nor edit it. `--isolated` grades this checkpoint alone."""
    args = [sys.executable, str(script), str(repo)] + (["--isolated"] if level == "isolated" else [])
    proc = subprocess.run(args, capture_output=True, text=True, timeout=300)
    tail = (proc.stdout + proc.stderr).strip().splitlines()
    return proc.returncode == 0, "\n".join(tail[-10:])


def load_series(name: str) -> tuple[list[Path], str | None]:
    """The checkpoints, and the seed the series names for itself.

    A `# seed: <name>` line is the only place the seed is declared. Inferring it
    from the filename meant that renaming a series quietly handed the agent the
    toy repository instead of the real one, and the run then measured nothing.
    """
    path = BENCH / "series" / f"{name}.txt"
    if not path.exists():
        raise SystemExit(f"bench: no series '{name}' (looked for {path})")
    tasks: list[Path] = []
    seed = None
    for line in path.read_text().splitlines():
        line = line.strip()
        if not line:
            continue
        if line.startswith("#"):
            if line.lower().startswith("# seed:"):
                seed = line.split(":", 1)[1].strip()
            continue
        tasks.append(BENCH / "tasks" / line)
    return tasks, seed


def workspace_digest(path: Path) -> str:
    """A cheap fingerprint of a repository's working tree, for the guard below."""
    proc = subprocess.run(["git", "-C", str(path), "status", "--porcelain"],
                          capture_output=True, text=True)
    return proc.stdout


def seed_spec(seed: str | None) -> dict | None:
    """A series may start from a real repository instead of the toy seed."""
    if not seed:
        return None
    path = BENCH / "series" / f"{seed}.seed"
    if not path.exists():
        raise SystemExit(f"bench: series names seed '{seed}', but {path} does not exist")
    return json.loads(path.read_text())


def seed_workspace(spec: dict, work: Path) -> None:
    """Copy the tracked files of a real repository, and link what git does not
    carry. `git archive` is the copy: it takes the files that are actually in the
    repository and none of the 745 MB of dependencies beside them."""
    source = Path(spec["from"]).expanduser()
    if not source.is_dir():
        raise SystemExit(f"bench: seed '{source}' is not a directory")
    tar = subprocess.run(["git", "-C", str(source), "archive", "HEAD"], capture_output=True, check=True)
    extract = subprocess.run(["tar", "-x", "-C", str(work)], input=tar.stdout, check=True)
    del extract
    for name in spec.get("link", []):
        target = source / name
        if not target.exists():
            continue
        if target.is_dir():
            # Hard links: same bytes, no pointer back to the source tree.
            subprocess.run(["cp", "-al", str(target), str(work / name)], check=True)
        else:
            shutil.copy2(target, work / name)


def run_series(series: str, arm: str, agent: str, timeout: int, out: Path, keep: bool) -> dict:
    tasks, seed_name = load_series(series)
    work = Path(tempfile.mkdtemp(prefix=f"bench-{series}-{arm}-"))
    spec = seed_spec(seed_name)
    source = None
    before = ""
    if spec:
        source = Path(spec["from"]).expanduser()
        before = workspace_digest(source)
        seed_workspace(spec, work)
    else:
        seed = BENCH / "seed"
        if seed.exists():
            shutil.copytree(seed, work, dirs_exist_ok=True)
    git(work, "init", "-q")
    git(work, "add", "-A")
    git(work, "-c", "user.email=bench@local", "-c", "user.name=bench", "commit", "-qm", "seed")

    prompt_prefix = PROMPT_PREFIX[arm].replace("{skills}", str(ROOT / "skills"))
    checkpoints: list[Checkpoint] = []
    for task_dir in tasks:
        prompt = prompt_prefix + (task_dir / "task.md").read_text()
        masked = Path(tempfile.mkdtemp(prefix="bench-verify-")) / "verify.py"
        shutil.copy(task_dir / "verify.py", masked)
        log = out / f"{arm}-{task_dir.name}.jsonl"
        raw, seconds, timed_out = run_agent(agent, arm, work, prompt, timeout, log)
        tokens, cost, calls, turns = usage_from_events(raw)
        strict, strict_detail = verify(work, masked, "strict")
        isolated, isolated_detail = verify(work, masked, "isolated")
        produced = any(True for _ in source_files(work)[0])
        touched: list[Path] | None = None
        if spec:
            changed = subprocess.run(["git", "status", "--porcelain"], cwd=work,
                                     capture_output=True, text=True).stdout
            touched = [work / line[3:].strip() for line in changed.splitlines()
                       if line[3:].strip() and (work / line[3:].strip()).suffix in SOURCE_EXT]
        quality = measure(work, touched) if produced else Quality()
        checkpoints.append(Checkpoint(
            task=task_dir.name, strict=strict, isolated=isolated,
            detail="" if strict else strict_detail, produced=produced,
            seconds=round(seconds, 1), timed_out=timed_out, tokens=tokens, cost=round(cost, 5),
            tool_calls=calls, turns=turns, quality=quality.as_dict()))
        git(work, "add", "-A")
        git(work, "-c", "user.email=bench@local", "-c", "user.name=bench", "commit", "-qm", task_dir.name)
        mark = ("strict" if strict else ("isolated" if isolated else "FAIL"))
        mark += " *" if timed_out else ""
        print(f"  {arm:9s} {task_dir.name:24s} {mark:8s} "
              f"erosion={quality.erosion:.2f} verbosity={quality.verbosity:.2f} "
              f"loc={quality.loc:4d} tok={tokens:6d} {seconds:5.0f}s")
        sys.stdout.flush()

    done = [c for c in checkpoints if c.produced]
    summary = {
        "series": series, "arm": arm, "model": model_of(out),
        "started": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
        "checkpoints": [c.as_dict() for c in checkpoints],
        "strict_rate": round(sum(c.strict for c in checkpoints) / len(checkpoints), 3),
        "isolated_rate": round(sum(c.isolated for c in checkpoints) / len(checkpoints), 3),
        "erosion": round(sum(c.quality["erosion"] for c in done) / len(done), 4) if done else None,
        "verbosity": round(sum(c.quality["verbosity"] for c in done) / len(done), 4) if done else None,
        "erosion_trajectory": [c.quality["erosion"] for c in done],
        "verbosity_trajectory": [c.quality["verbosity"] for c in done],
        "tokens": sum(c.tokens for c in checkpoints),
        "cost": round(sum(c.cost for c in checkpoints), 5),
        "seconds": round(sum(c.seconds for c in checkpoints), 1),
        "tool_calls": sum(c.tool_calls for c in checkpoints),
        "timed_out": sum(c.timed_out for c in checkpoints),
    }
    if source is not None and workspace_digest(source) != before:
        summary["escaped"] = True
        print(f"  !! the agent wrote to the seed repository at {source}", file=sys.stderr)
        print("     restore it with `git -C <seed> status` and `git checkout -- <paths>`", file=sys.stderr)
    if keep:
        summary["kept"] = str(work)
    else:
        shutil.rmtree(work, ignore_errors=True)
    return summary


def model_of(out: Path) -> str:
    for log in sorted(out.glob("*.jsonl")):
        for line in log.read_text(errors="ignore").splitlines():
            if '"model"' in line and "message_end" in line:
                try:
                    return json.loads(line)["message"].get("model", "unknown")
                except (json.JSONDecodeError, KeyError):
                    continue
    return "unknown"


# --------------------------------------------------------------------------
# report
# --------------------------------------------------------------------------


def compare(base: dict, work: dict) -> tuple[str, str, str]:
    """Lexicographic: correctness, then erosion, then verbosity, then cost.

    The workflow wins only if it is not worse on an earlier axis. A cheaper arm
    that is less correct has not won anything.
    """
    if work["strict_rate"] != base["strict_rate"]:
        return ("correctness", "better" if work["strict_rate"] > base["strict_rate"] else "worse", "")
    if work["erosion"] != base["erosion"]:
        return ("erosion", "better" if work["erosion"] < base["erosion"] else "worse", "")
    if work["verbosity"] != base["verbosity"]:
        return ("verbosity", "better" if work["verbosity"] < base["verbosity"] else "worse", "")
    if work["tokens"] != base["tokens"]:
        return ("cost", "better" if work["tokens"] < base["tokens"] else "worse", "")
    return ("nothing", "tied", "the arms are identical on all four axes")


def report(directory: Path) -> int:
    runs = []
    for path in sorted(directory.glob("*.json")):
        try:
            runs.append(json.loads(path.read_text()))
        except json.JSONDecodeError:
            continue
    if not runs:
        print(f"bench: no results in {directory} — run `bench --run <series> --arm <arm>`")
        return 1

    by_series: dict[str, dict[str, dict]] = {}
    for run in runs:
        by_series.setdefault(run["series"], {})[run["arm"]] = run

    lines = ["# bench", "",
             "Compared in this order, and no other: **correctness → erosion → verbosity → cost**.",
             "`strict` is every test passing, regressions included. `isolated` is this checkpoint",
             "alone, so a landed feature that broke an earlier one still reads as landed.",
             "", "## Results", "",
             "| arm | strict | isolated | erosion ↓ | verbosity ↓ | tokens | $ | minutes |",
             "| --- | --- | --- | --- | --- | --- | --- | --- |"]
    verdict = 0
    for series, arms in sorted(by_series.items()):
        lines += ["", f"### {series}", ""]
        for arm in ("bare", "baseline", "workflow"):
            run = arms.get(arm)
            if not run:
                continue
            erosion = "n/a" if run["erosion"] is None else f"{run['erosion']:.3f}"
            verbosity = "n/a" if run["verbosity"] is None else f"{run['verbosity']:.3f}"
            lines.append(
                f"| {arm} | {run['strict_rate'] * 100:.0f}% | {run['isolated_rate'] * 100:.0f}% | "
                f"{erosion} | {verbosity} | {run['tokens']} | {run['cost']:.4f} | {run['seconds'] / 60:.1f} |")
        base = arms.get("baseline")
        work = arms.get("workflow")
        if base and work:
            axis, direction, note = compare(base, work)
            if direction == "worse":
                verdict = 1
            lines += ["", f"workflow vs baseline: **{direction} on {axis}**"
                          + (f" — {note}" if note else "")
                          + ". " + ("Ship it." if direction == "better" else
                                    "The workflow is not paying for itself on this series.")]
        if any(arms.get(a) for a in ("baseline", "workflow")):
            lines += ["", "Trajectories (erosion): " + " · ".join(
                f"{arm} {' → '.join(f'{v:.2f}' for v in run['erosion_trajectory']) or '—'}"
                for arm in ("baseline", "workflow") if (run := arms.get(arm)))]
    lines += ["", "Model: " + ", ".join(sorted({r["model"] for r in runs})),
              "Fresh session per checkpoint, identical seed repository, identical prompts.",
              "Solve rates use a fixed denominator; quality is averaged over checkpoints that",
              "produced code, never imputed for a run that crashed.",
              "`*` marks a checkpoint killed at the timeout: it may have been mid-edit, so its",
              "grader ran on a codebase the agent had not finished with."]
    text = "\n".join(lines)
    (directory / "report.md").write_text(text + "\n")
    print(text)
    return verdict


# --------------------------------------------------------------------------
# cli
# --------------------------------------------------------------------------


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("--list", action="store_true", help="show series and their checkpoints")
    parser.add_argument("--run", metavar="SERIES")
    parser.add_argument("--arm", action="append", default=[])
    parser.add_argument("--agent", default=os.environ.get("BENCH_AGENT", "pi -p --mode json"))
    parser.add_argument("--timeout", type=int, default=900, help="per-checkpoint seconds (default 900)")
    parser.add_argument("--out", default=str(RESULTS))
    parser.add_argument("--keep", action="store_true", help="keep the scratch repository")
    parser.add_argument("--report", action="store_true")
    parser.add_argument("--self-test", action="store_true")
    args = parser.parse_args(argv[1:])

    if args.list:
        for path in sorted((BENCH / "series").glob("*.txt")):
            print(path.stem)
            for task in load_series(path.stem)[0]:
                print(f"  {task.name}")
        return 0

    if args.self_test:
        return subprocess.run([sys.executable, str(ROOT / "checks" / "test_bench.py")]).returncode

    if args.report:
        return report(Path(args.out))

    if not args.run:
        parser.print_help()
        return 2

    out = Path(args.out)
    out.mkdir(parents=True, exist_ok=True)
    arms = args.arm or ["baseline", "workflow"]
    stamp = time.strftime("%Y%m%d-%H%M%S")
    for arm in arms:
        print(f"bench: {args.run} · {arm}")
        summary = run_series(args.run, arm, args.agent, args.timeout, out, args.keep)
        (out / f"{stamp}-{args.run}-{arm}.json").write_text(json.dumps(summary, indent=2) + "\n")
        print(f"  -> strict {summary['strict_rate'] * 100:.0f}%  "
              f"erosion {summary['erosion']}  verbosity {summary['verbosity']}  "
              f"{summary['tokens']} tokens  {summary['seconds'] / 60:.1f} min")
    return report(out)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
