# lizard
# --------------------------------------------------------------------------


def run_lizard(paths: list[str]) -> list[dict]:
    cmd = [sys.executable, "-m", "lizard", "--csv", *paths]
    try:
        proc = subprocess.run(cmd, capture_output=True, text=True)
    except FileNotFoundError:
        die("lizard is not installed. Run: python3 -m pip install --user lizard")
    if proc.returncode != 0 and not proc.stdout.strip():
        die(f"lizard failed:\n{proc.stderr.strip()}")
    rows = []
    for row in csv.reader(proc.stdout.splitlines()):
        if len(row) < 11:
            continue
        try:
            rows.append({"nloc": int(row[0]), "ccn": int(row[1]), "params": int(row[3]), "file": row[6], "name": row[7], "start": int(row[9]), "end": int(row[10])})
        except ValueError:
            continue
    return rows


def extract_params(declaration: str, name: str) -> list[str]:
    """Parameter names from a declaration, best effort.

    lizard reports how many parameters a function has, not what they are called,
    and the pass-through rule needs the names. A failure here degrades the rule
    to name equality, which is the book's own example, so it is not fatal.
    """
    anchor = declaration.find(name) if name and name != "(anonymous)" else -1
    start = declaration.find("(", anchor if anchor >= 0 else 0)
    if start < 0:
        return []
    depth = 0
    end = -1
    for index in range(start, len(declaration)):
        char = declaration[index]
        if char == "(":
            depth += 1
        elif char == ")":
            depth -= 1
            if depth == 0:
                end = index
                break
    if end < 0:
        return []
    inner = declaration[start + 1 : end]
    parts: list[str] = []
    depth = 0
    current = ""
    for char in inner:
        if char in "([{<":
            depth += 1
        elif char in ")]}>":
            depth -= 1
        if char == "," and depth == 0:
            parts.append(current)
            current = ""
            continue
        current += char
    parts.append(current)
    names: list[str] = []
    for part in parts:
        part = part.strip().lstrip("*&").strip()
        if not part:
            continue
        match = re.match(r"(?:readonly|public|private|protected|static|final|self|cls[\s,]*)*\s*([A-Za-z_$][\w$]*)", part)
        if match and match.group(1) not in {"self", "cls"}:
            names.append(match.group(1))
    return names


def declaration_text(lines: list[str], start: int, name: str) -> str:
    """The declaration, joined across the lines it spans, up to the body's brace."""
    out: list[str] = []
    for offset in range(0, 6):
        index = start - 1 + offset
        if index >= len(lines):
            break
        out.append(lines[index])
        joined = " ".join(out)
        if name in joined and ("{" in joined.split(name, 1)[-1] or ":" in joined.split(name, 1)[-1]):
            break
    return " ".join(out)


def line_at(lines: list[str], number: int) -> str:
    return lines[number - 1] if 1 <= number <= len(lines) else ""


def body_statements(lines: list[str], start: int, end: int) -> tuple[int, list[str]]:
    """Count statements in the body: non-blank lines that are not braces alone.

    lizard's nloc counts the declaration line and the closing brace, so a
    one-statement method reports 3. Counting statements is what the shallow
    rule actually means.
    """
    body: list[str] = []
    for index in range(start, min(end, len(lines))):
        stripped = lines[index].strip()
        if not stripped or stripped in {"{", "}", "};"}:
            continue
        body.append(stripped)
    return len(body), body


# --------------------------------------------------------------------------
# index: literals, shapes, imports, symbols, call edges
# --------------------------------------------------------------------------
#
# The four detectors above read one file at a time. This section exists so a
# detector can ask a question *across* files, because the flags that matter most
# are facts about a pair of modules rather than about a line. Information
# leakage is the clearest case: the book's own example is a banner colour
# written centrally and a darker emphasis shade written separately on a few
# pages, so the finding only exists in the relationship between two files.
#
# Three substrates, all already in the project's toolchain: the text (literals
# and record shapes), the import graph (which module knows about which), and git
# (which files change together).

LITERAL_MIN_INNER = 4
SHAPE_MIN_FIELDS = 3
SHAPE_OVERLAP = 0.7
CO_CHANGE_MIN = 5
CO_CHANGE_DAYS = 365
CO_CHANGE_MAX_COMMIT_FILES = 30
CHAIN_MIN_DEPTH = 3
CHAIN_MAX_DEPTH = 8

CALL_KEYWORDS = frozenset(
    """if elif else for while switch case catch return throw await yield typeof
    new in of do try finally function class def import require super print
    println assert raise del lambda with as and or not""".split()
)

TS_IMPORT = re.compile(r"""import\s+(?:type\s+)?(.+?)\s+from\s+["']([^"']+)["']""")
TS_SIDE_EFFECT_IMPORT = re.compile(r"""import\s+["']([^"']+)["']""")
TS_REEXPORT = re.compile(r"""export\s+(?:\*(?:\s+as\s+\w+)?|\{[^}]*\})\s+from\s+["']([^"']+)["']""")
TS_REQUIRE = re.compile(r"""require\(\s*["']([^"']+)["']\s*\)""")
PY_FROM = re.compile(r"^\s*from\s+([.\w]+)\s+import\s+([^\n#]+)", re.MULTILINE)
PY_IMPORT = re.compile(r"^\s*import\s+(\.?[\w.]+)", re.MULTILINE)
TS_DECLARATION = re.compile(r"(?:export\s+)?(?:interface|type|class|enum)\s+([A-Za-z_$][\w$]*)")
CLASS_DECLARATION = re.compile(r"^\s*(?:export\s+(?:default\s+)?)?(?:abstract\s+)?class\s+([A-Za-z_$][\w$]*)")
PY_CLASS = re.compile(r"^(\s*)class\s+([A-Za-z_]\w*)", re.MULTILINE)
STRING_LITERAL = re.compile(r'"(?:[^"\\\n]|\\.)*"|\'(?:[^\'\\\n]|\\.)*\'')
TEMPLATE_LITERAL = re.compile(r"`(?:[^`\\]|\\.)*`", re.DOTALL)
NUMBER_LITERAL = re.compile(r"(?<![\w#.])(?:\d{4,}|\d+\.\d{3,}|\d{3,}\.\d+)(?![\w.])")
# A file directive is an instruction to the toolchain, not a fact about the
# system: every client component in a Next.js tree says `"use client"`, and a
# flag that reports all forty-nine of them is reporting the framework.
DIRECTIVES = frozenset({"use client", "use server", "use strict", "use asm"})
# A four-digit integer that is a calendar year is a citation, not a constant:
# `Joshi et al. (2025)` sits in JSX text and in prose, where no mask can reach
# it, and two files citing the same paper are not two files agreeing on a value.
YEAR_RANGE = (1900, 2100)
CALL_SITE = re.compile(r"([A-Za-z_$][\w$]*)\s*\(")
# A line whose string is a module address rather than domain knowledge:
# `import ... from "./x"`, `export ... from "./x"`, Python's `from pkg import a`,
# and any line carrying a `require(...)`. Two modules importing the same file is
# not two modules knowing the same fact, and reporting it would drown the flag
# in every sibling module that shares a parent.
MODULE_REFERENCE = re.compile(r"^\s*(?:import\b|from\b|export\b[^=]*\bfrom\b)")
# A module specifier is not always on the line that starts the statement: a
# multi-line `import type {\n  X,\n} from "@/y"` puts the path on a line that
# begins with `}`, and an inline `import("@/y")` puts it mid-expression. What
# identifies it is the token in front of the string, not the start of the line.
SPECIFIER_BEFORE = re.compile(r"\b(?:from|import|require|mock)\(?\s*$")
# Two or more lowercase, dash-separated words is a class list: Tailwind and its
# relatives are written as strings, repeated on purpose, and a flag that reports
# `flex min-w-0 flex-col` is reporting the styling idiom. One word is left
# alone, because `x-forwarded-for` and `application/json` are one word too.
CLASS_LIST = re.compile(r"^[a-z][a-z0-9:_/-]*(?:\s+[a-z][a-z0-9:_/-]*)+$")


@dataclass
class Symbol:
    """A declared method, with what a cross-file check needs."""

    name: str
    file: str
    line: int
    exported: bool
    public: bool
    start: int
    end: int
    ccn: int
    statements: int
    params: list[str]
    body: str


@dataclass
class Record:
    """The field names of an interface, type, dataclass or class.

    Two of these sharing most of their fields, in two different modules, is one
    design decision written down twice — the book's file-format pair, where the
    reader and the writer each know the layout.
    """

    name: str
    file: str
    line: int
    fields: frozenset[str]


@dataclass
class Call:
    callee: str
    args: list[str]
    spans: list[tuple[int, int]]


@dataclass
class Module:
    path: Path
    display: str
    language: str
    lines: list[str]
    masked: list[str]
    code: list[str]
    nest: dict[int, int]
    comments: list[Comment]
    symbols: list[Symbol]
    records: list[Record]
    literals: dict[str, list[int]]
    imports: dict[str, set[str]]


@dataclass
class Index:
    modules: list[Module]
    importers: dict[str, set[str]]
    imported_names: dict[str, set[str]]
    literals: dict[str, dict[str, list[int]]]
    records: list[Record]
    root: Path


def interface_function_name(name: str) -> bool:
    """A name that can be part of a module's interface.

    A lambda is not a module, and neither is a constructor: the pass-through and
    shallow-module flags are about names the rest of the system can call.
    """
    return name not in {"(anonymous)", "constructor", "__init__"}


def is_module_export(line: str, language: str, nest: int) -> bool:
    """Whether the name itself is importable from the module.

    Only module-level declarations are: a method is reached through its class,
    never by name, which is why `needless-export` must not be handed methods.
    Python's convention is the underscore; `__all__` is not consulted, because
    treating every public name as exported is the conservative direction for a
    check that only fires when a module has consumers that ignore the name.
    """
    if nest > 0:
        return False
    stripped = line.strip()
    if language == "py":
        match = re.match(r"(?:async\s+)?(?:def|class)\s+([A-Za-z_]\w*)", stripped)
        return bool(match) and not match.group(1).startswith("_")
    return stripped.startswith("export ")


def is_public_member(line: str, language: str, nest: int, enclosing: tuple[str, str] | None) -> bool:
    """Whether a consumer can call this, counting the class it sits in.

    `export class TextArea` puts every public method of that class on the
    module's interface without any of those methods saying `export`, and a class
    whose interface is its methods is exactly the shape the shallow-module
    reading is about. `private`, `protected` and `#` say otherwise, and so does
    Python's leading underscore — on the method, or on the class that owns it.
    """
    if nest == 0:
        return is_module_export(line, language, nest)
    stripped = line.strip()
    if language == "py":
        match = re.match(r"(?:async\s+)?def\s+([A-Za-z_]\w*)", stripped)
        if not match or match.group(1).startswith("_"):
            return False
        return enclosing is not None and not enclosing[0].startswith("_")
    if re.match(r"(?:private|protected)\b|#\w", stripped):
        return False
    return enclosing is not None and enclosing[1].strip().startswith("export ")


def enclosing_class(code_lines: list[str], nest: dict[int, int], start: int) -> tuple[str, str] | None:
    """The nearest class declaration enclosing this line, as (name, line).

    The nearest line at a lower depth is the enclosing declaration: for a
    method that is its class, and for a module-level function there is none.
    """
    depth = nest.get(start, 0)
    for number in range(start - 1, 0, -1):
        if nest.get(number, 0) < depth:
            match = CLASS_DECLARATION.match(code_lines[number - 1])
            return (match.group(1), code_lines[number - 1]) if match else None
    return None


def mask_strings(text: str) -> str:
    """Blank the inside of every string literal, keeping every offset.

    Brace matching, argument splitting and identifier scanning run over this
    rather than the raw text, so a `}` inside a string cannot close a block and
    a comma inside one cannot split an argument list. Lengths are preserved, and
    so are the line breaks inside a multi-line template literal, because a mask
    that moved a line would move every line number after it.
    """

    def blank(match: re.Match[str]) -> str:
        whole = match.group(0)
        inner = "".join("\n" if char == "\n" else " " for char in whole[1:-1])
        return whole[0] + inner + whole[-1]

    return TEMPLATE_LITERAL.sub(blank, STRING_LITERAL.sub(blank, text))


def literals_in(code: list[str], masked: list[str]) -> dict[str, list[int]]:
    """Literals keyed by their text, with the lines they occur on.

    Strings are read from the code and numbers from the masked code, because a
    number inside a string is text and not a constant: `(8000+ tokens)` in a
    prompt and `duration-1000` in a Tailwind class name are prose, and counting
    them invents a leak between a prompt and a toast timeout.

    Keys carry a kind prefix so a number cannot collide with the string of the
    same digits, and the quotes are stripped from string keys so `"a/b"` and
    `'a/b'` count as one piece of knowledge.

    Short literals are dropped: a two-character string is a delimiter, not a
    decision. Numbers need four digits, or enough significant digits to be a
    measurement rather than a layout fraction — `1.60934` and `100.5` are
    values, `1.5` and `0.5` are the padding of every UI on earth. File
    directives are dropped by value, because `"use client"` in forty-nine
    modules is the framework, not a leak.

    Import lines are skipped, because a module specifier is an address, not a
    fact: two files that import the same module agree about where something
    lives, not about how the system behaves. That exclusion is the rule's main
    lie — a literal that is genuinely shared *and* happens to sit on a require
    line is missed, and nothing else in the tool would notice it.
    """
    found: dict[str, list[int]] = {}
    for number, line in enumerate(code, start=1):
        if MODULE_REFERENCE.match(line) or "require(" in line:
            continue
        for pattern in (STRING_LITERAL, TEMPLATE_LITERAL):
            for match in pattern.finditer(line):
                inner = match.group(0)[1:-1]
                if inner in DIRECTIVES:
                    continue  # a file directive, not a value
                if len(inner) < LITERAL_MIN_INNER or "${" in inner:
                    continue
                if match.start() > 0 and line[match.start() - 1] in "fF":
                    continue  # an f-string interpolates code, so it is not a value
                if SPECIFIER_BEFORE.search(line[: match.start()]):
                    continue  # a module specifier, wherever the statement wraps
                if CLASS_LIST.match(inner):
                    continue  # a class list, not a value
                found.setdefault("s:" + inner, []).append(number)
        for match in NUMBER_LITERAL.finditer(masked[number - 1]):
            if len(match.group(0)) == 4 and YEAR_RANGE[0] <= int(match.group(0)) <= YEAR_RANGE[1]:
                continue  # a year, most likely a citation
            found.setdefault("n:" + match.group(0), []).append(number)
    return found


def _block_end(text: str, start: int) -> int:
    """Index just past the brace block opening at `start`, or -1."""
    depth = 0
    for index in range(start, len(text)):
        char = text[index]
        if char == "{":
            depth += 1
        elif char == "}":
            depth -= 1
            if depth == 0:
                return index + 1
    return -1


def _fields_at_class_level(block: str) -> frozenset[str]:
    """Field names declared one brace level inside a block.

    One level in is the body of the interface or class; deeper is a nested type
    and belongs to a different declaration. Method signatures are excluded by
    requiring a colon or an equals after the name.
    """
    fields: set[str] = set()
    depth = 0
    for line in block.splitlines():
        stripped = line.strip()
        if not stripped:
            continue
        depth += stripped.count("{") - stripped.count("}")
        if depth != 1:
            continue
        match = re.match(
            r"(?:(?:public|private|protected|readonly|static|final|declare)\s+)*([A-Za-z_$][\w$]*)\s*[?!]?\s*[:=]",
            stripped,
        )
        if match:
            fields.add(match.group(1).lstrip("_"))
    return frozenset(fields)


def _python_fields(lines: list[str], start: int) -> frozenset[str]:
    """A Python class's state: attribute assignments and annotated fields."""
    class_line = lines[start - 1]
    class_indent = len(class_line) - len(class_line.lstrip())
    fields: set[str] = set()
    for line in lines[start:]:
        if not line.strip():
            continue
        indent = len(line) - len(line.lstrip())
        if indent <= class_indent:
            break
        for match in re.finditer(r"self\.([A-Za-z_]\w*)\s*[:=]", line):
            fields.add(match.group(1).lstrip("_"))
        annotated = re.match(r"\s*([A-Za-z_]\w*)\s*:\s*[^=]+$", line)
        if annotated and indent - class_indent <= 4:
            fields.add(annotated.group(1).lstrip("_"))
    return frozenset(fields)


def records_in(masked_lines: list[str], lines: list[str], language: str, display: str) -> list[Record]:
    """Record-like declarations and their field names.

    A class counts as well as an interface: the flag is about one shape known in
    two places, and a class's fields are a shape like any other. Field names are
    compared with a leading underscore stripped, because a Python record and a
    TypeScript one describe the same wire format whether or not one of them
    marks its fields private.
    """
    masked = "\n".join(masked_lines)
    out: list[Record] = []
    if language == "py":
        for match in PY_CLASS.finditer(masked):
            line = masked[: match.start()].count("\n") + 1
            fields = _python_fields(lines, line)
            if len(fields) >= SHAPE_MIN_FIELDS:
                out.append(Record(name=match.group(2), file=display, line=line, fields=fields))
        return out
    for match in TS_DECLARATION.finditer(masked):
        opening = masked.find("{", match.end() - 1)
        if opening < 0:
            continue
        end = _block_end(masked, opening)
        if end < 0:
            continue
        # A one-line declaration (`type X = { a: T; b: U }`) needs its semicolons
        # to become line breaks before the depth walk can see two fields.
        block = masked[opening:end].replace("{", "{\n", 1).replace("}", "\n}", 1).replace(";", ";\n")
        fields = _fields_at_class_level(block)
        if len(fields) >= SHAPE_MIN_FIELDS:
            line = masked[: match.start()].count("\n") + 1
            out.append(Record(name=match.group(1), file=display, line=line, fields=fields))
    return out


def imports_in(code_lines: list[str], language: str) -> dict[str, set[str]]:
    """Imported module paths, and the names taken from each.

    Read from the comment-stripped code, not the masked code: the module path is
    inside a string literal, and masking is exactly what would blank it. Comments
    are still removed, so a commented-out import is not an edge.

    `import { A, B as C }` records A and B, the names the exporting module
    knows; a default import records `default`; a namespace or wildcard import
    records `*`, which the checks downstream read as "everything in that module
    may be used" rather than as a list of names.
    """
    text = "\n".join(code_lines)
    out: dict[str, set[str]] = {}
    if language == "py":
        for match in PY_FROM.finditer(text):
            names = {part.strip().split(" as ")[0].strip() for part in match.group(2).split(",")}
            out.setdefault(match.group(1), set()).update(name for name in names if name)
        for match in PY_IMPORT.finditer(text):
            out.setdefault(match.group(1), set()).add("*")
        return out
    for match in TS_IMPORT.finditer(text):
        clause, target = match.group(1), match.group(2)
        names: set[str] = set()
        if "*" in clause:
            names.add("*")
        for group in re.findall(r"\{([^}]*)\}", clause):
            for part in group.split(","):
                name = part.strip().split(" as ")[0].strip()
                if name:
                    names.add(name)
        remainder = re.sub(r"\{[^}]*\}", "", clause).replace("* as", "").strip().strip(",").strip()
        if remainder and not remainder.startswith("*"):
            names.add("default")
        out.setdefault(target, set()).update(names or {"*"})
    for pattern in (TS_REEXPORT, TS_REQUIRE, TS_SIDE_EFFECT_IMPORT):
        for match in pattern.finditer(text):
            out.setdefault(match.group(1), set()).add("*")
    return out


def resolve_import(from_display: str, target: str, language: str, known: set[str]) -> str | None:
    """The scanned file an import refers to, or None when it is external.

    Best effort, deliberately: a miss costs one cross-file finding, not a crash.
    TypeScript's extensionless specifiers, `index` files, and Python packages
    rooted at a `src` directory are handled; a build alias such as
    `@/infrastructure` resolves only when it happens to spell a real path.
    """
    if language == "py":
        if target.startswith("."):
            dots = len(target) - len(target.lstrip("."))
            rest = [part for part in target.lstrip(".").split(".") if part]
            parts = posixpath.dirname(from_display).split("/")
            base_parts = parts[: len(parts) - (dots - 1)] if dots > 1 else parts
            base = "/".join(base_parts + rest)
        else:
            base = "/".join(target.split("."))
        for candidate in (base + ".py", base + "/__init__.py"):
            if candidate in known:
                return candidate
        for path in known:
            if path.endswith("/" + base + ".py") or path.endswith("/" + base + "/__init__.py"):
                return path
        return None
    if not target.startswith("."):
        for path in known:
            if path.endswith("/" + target.lstrip("./")):
                return path
        return None
    cleaned = re.sub(r"\.(js|jsx|mjs|cjs|ts|tsx)$", "", target)
    base = posixpath.normpath(posixpath.join(posixpath.dirname(from_display), cleaned))
    for candidate in (
        base,
        base + ".ts",
        base + ".tsx",
        base + ".js",
        base + ".jsx",
        base + "/index.ts",
        base + "/index.tsx",
        base + "/index.js",
    ):
        if candidate in known:
            return candidate
    return None


def calls_in(body: str) -> list[Call]:
    """Calls in a body: callee name, top-level arguments, and their offsets."""
    calls: list[Call] = []
    for match in CALL_SITE.finditer(body):
        callee = match.group(1)
        if callee in CALL_KEYWORDS:
            continue
        opening = match.end() - 1
        depth = 0
        end = -1
        for index in range(opening, len(body)):
            char = body[index]
            if char in "([{":
                depth += 1
            elif char in ")]}":
                depth -= 1
                if depth == 0:
                    end = index
                    break
        if end < 0:
            continue
        args: list[str] = []
        spans: list[tuple[int, int]] = []
        depth = 0
        part_start = opening + 1
        for index in range(opening + 1, end):
            char = body[index]
            if char in "([{":
                depth += 1
            elif char in ")]}":
                depth -= 1
            elif char == "," and depth == 0:
                args.append(body[part_start:index])
                spans.append((part_start, index))
                part_start = index + 1
        args.append(body[part_start:end])
        spans.append((part_start, end))
        calls.append(Call(callee=callee, args=args, spans=spans))
    return calls


def forwarded_params(body: str, params: list[str]) -> list[str]:
    """Parameters the body never reads, only forwards into calls.

    A parameter is forwarded when every occurrence of it in the body sits inside
    a call's argument list as that whole argument — `m3(cert)` — and nowhere
    else: not compared, not indexed, not returned, not stored. A parameter that
    appears in no call at all is unused rather than forwarded, which is a
    different finding and is not reported here.

    Occurrences are counted in the body *with its strings intact*, while the
    calls and their argument spans are read from the masked copy. The two have
    identical offsets, and the difference is the point: a parameter interpolated
    into a log line — `` `started ${id.slice(0, 12)}` `` — has been read, and a
    detector that masks the string first sees only the one call that forwards
    it. That is how a chain of eight was reported in a file where every method
    used its parameter in a log line.

    The body excludes the declaration, or every parameter would be found in the
    signature and nothing would ever look forwarded.
    """
    forward_spans: list[tuple[int, int]] = []
    for call in calls_in(mask_strings(body)):
        for argument, span in zip(call.args, call.spans):
            if argument.strip().isidentifier():
                forward_spans.append(span)
    forwarded: list[str] = []
    for param in params:
        occurrences = [match.span() for match in re.finditer(rf"\b{re.escape(param)}\b", body)]
        if not occurrences:
            continue
        if all(any(start <= begin and end >= finish for start, end in forward_spans) for begin, finish in occurrences):
            forwarded.append(param)
    return forwarded


def symbols_in(
    rows: list[dict],
    lines: list[str],
    code_lines: list[str],
    language: str,
    display: str,
    nest: dict[int, int],
) -> list[Symbol]:
    """Declared methods as symbols, with export status and bodies.

    The declaration test and the interface-level test live here rather than in
    each detector, because they are what make a name a *method*: lizard reports
    a lambda handed to a hook and a JSX binding as functions, and it attributes
    them to names the line does not bind.

    lizard's `start` is the declaration's line, so the body is
    `code_lines[start:end]` — one-based start, zero-based slice — which excludes
    the signature and therefore the parameters, so a forwarded parameter cannot
    be "found" in its own declaration. The body keeps its string literals,
    because a parameter interpolated into a log line has been read; the call
    scan masks them when it needs to.
    """
    out: list[Symbol] = []
    for row in rows:
        line = line_at(lines, row["start"])
        if not interface_function_name(row["name"]):
            continue
        if nest.get(row["start"], MAX_INTERFACE_NEST + 1) > MAX_INTERFACE_NEST:
            continue
        if not declares(line, row["name"]):
            continue
        statements, _ = body_statements(lines, row["start"], row["end"])
        depth = nest.get(row["start"], 0)
        enclosing = enclosing_class(code_lines, nest, row["start"])
        out.append(
            Symbol(
                name=row["name"],
                file=display,
                line=row["start"],
                exported=is_module_export(line, language, depth),
                public=is_public_member(line, language, depth, enclosing),
                start=row["start"],
                end=row["end"],
                ccn=row["ccn"],
                statements=statements,
                params=extract_params(declaration_text(lines, row["start"], row["name"]), row["name"]),
                body="\n".join(code_lines[row["start"] : min(row["end"], len(code_lines))]),
            )
        )
    return out


def build_index(modules: list[Module], root: Path) -> Index:
    """The cross-file facts: who imports whom, which names are taken, and every
    literal with the modules it appears in."""
    known = {module.display for module in modules}
    importers: dict[str, set[str]] = {}
    imported_names: dict[str, set[str]] = {}
    literals: dict[str, dict[str, list[int]]] = {}
    for module in modules:
        for literal, lines in module.literals.items():
            literals.setdefault(literal, {})[module.display] = lines
        for target, names in module.imports.items():
            resolved = resolve_import(module.display, target, module.language, known)
            if resolved is None:
                continue
            importers.setdefault(resolved, set()).add(module.display)
            bucket = imported_names.setdefault(resolved, set())
            if "*" in names:
                bucket.add("*")
            else:
                bucket.update(names)
    records = [record for module in modules for record in module.records]
    return Index(modules=modules, importers=importers, imported_names=imported_names, literals=literals, records=records, root=root)


