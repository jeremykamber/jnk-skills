# Words that carry no information on their own. Kept deliberately short: the
# repeats rule works by overlap of *content* words, and a long stopword list
# would empty the comment and make every comment look like a repeat.
STOPWORDS = frozenset(
    """a an and are as at be been but by can could do does for from had has have
    here if in into is it its may might must no not of on or our out should so
    some such than that the their them then there these they this those to up
    us was we were what when where which while who why will with would you your
    """.split()
)

# Implementation vocabulary. Not words that are wrong anywhere — words that are
# wrong in a *declaration* comment, where they describe mechanism the caller
# does not need. A fix for the flag is usually "move this sentence into the
# body", which is why the fix menu says so.
IMPL_WORDS = frozenset(
    """algorithm cache cached complexity data structure evaluated hash hashing
    implemented implementation internally iterator iterate iterates iteration
    lock locked mutex loop loops recursion recursive structure structures
    thereby walk walks""".split()
)

# Per red flag: the moves, when each applies, and when it does not. This is the
# book's own repair set, enumerated — the delegation in jo-8 injects exactly
# one row and asks a fresh subagent to choose, rather than to invent.
REPAIRS: dict[str, list[dict[str, str]]] = {
    "shallow-method": [
        {
            "move": "inline into the caller",
            "apply_when": "the method has one caller, and the call site reads no worse than the body",
            "not_when": "the name marks a domain concept others will search for, or the caller would then duplicate the sequence",
        },
        {
            "move": "raise the interface",
            "apply_when": "several callers perform the same sequence the method implements one step of",
            "not_when": "the sequence differs at each call site; the shared piece is only the step",
        },
        {
            "move": "merge into the module that owns the data it touches",
            "apply_when": "the method is a thin accessor over another module's state",
            "not_when": "the state it touches is this module's own",
        },
        {
            "move": "keep it, and record why",
            "apply_when": "it is a deliberate adapter or seam the design needs at that boundary",
            "not_when": "the reason is 'a style guide said methods should be short'",
        },
    ],
    "pass-through": [
        {
            "move": "expose the lower object and delete the method",
            "apply_when": "callers can hold the lower object, and it does not leak knowledge the upper module owns",
            "not_when": "the lower object's interface exposes a representation the upper module is hiding",
        },
        {
            "move": "redistribute the functionality",
            "apply_when": "the two classes each implement part of one job",
            "not_when": "only one of them holds any state the job needs",
        },
        {
            "move": "merge the two classes",
            "apply_when": "the responsibilities cannot be told apart, and the pair shares the knowledge anyway",
            "not_when": "the pair is large; merging gives one class two jobs rather than one job and a seam",
        },
    ],
    "comment-repeats-code": [
        {
            "move": "delete the comment",
            "apply_when": "the line already says it, and nothing about it is surprising",
            "not_when": "the line is surprising and the comment is the only thing making it obvious",
        },
        {
            "move": "raise the comment to intent",
            "apply_when": "the line's purpose or its 'how we got here' is not obvious from the line",
            "not_when": "the raised version would have to invent rationale that is not true",
        },
        {
            "move": "add the precision the declaration lacks",
            "apply_when": "the comment sits on a declaration: units, boundary inclusive-or-exclusive, null meaning, invariants, who frees it",
            "not_when": "the value genuinely has no units or boundary",
        },
    ],
    "implementation-narrative-comment": [
        {
            "move": "move the sentence into the body",
            "apply_when": "it explains mechanism to the next person editing this method",
            "not_when": "the mechanism is a precondition the caller must satisfy",
        },
        {
            "move": "restate it as the promise",
            "apply_when": "the comment describes what the method does to the caller's world",
            "not_when": "there is no promise to state; the method is a private helper",
        },
        {
            "move": "name the missing abstraction",
            "apply_when": "an implementation sentence is needed because the interface is not a thing yet — the comment is the red flag that the module is shallow",
            "not_when": "the interface is already a coherent concept and the sentence is just misplaced",
        },
    ],
    "leaked-literal": [
        {
            "move": "give the value one owner and import it",
            "apply_when": "it is a fact about the system rather than a local choice: a colour, a size, a limit, a wire name, a path",
            "not_when": "the copies are coincidentally equal, and either is free to change without the other",
        },
        {
            "move": "move it to the module both sides already depend on",
            "apply_when": "a lower module exists that every module holding a copy already imports",
            "not_when": "the only shared module is the leaf being refactored, so the owner would be an ancestor of its users",
        },
        {
            "move": "promote it to a parameter of the interface",
            "apply_when": "the value is policy a caller legitimately chooses, and the interface should say so",
            "not_when": "the value is not a choice — the format is the format",
        },
    ],
    "leaked-shape": [
        {
            "move": "one module declares the shape, the other imports it",
            "apply_when": "one of the two is the natural owner of the format — the parser, the writer, the schema",
            "not_when": "both are leaves that must not depend on each other; then the shape belongs below both",
        },
        {
            "move": "extract the shape into the module that sits below both",
            "apply_when": "the two are siblings at the same layer, and neither may import the other",
            "not_when": "the shared fields are a third of each record and the rest genuinely differs; those are two shapes, not one",
        },
        {
            "move": "merge the two modules",
            "apply_when": "they know the same shape because they are the same job split in two",
            "not_when": "the split is a real boundary — a reader and a writer, a client and a server",
        },
    ],
    "co-change-without-import": [
        {
            "move": "make the dependency explicit",
            "apply_when": "one file's change needs the other's: import it, or state the invariant in one place both can cite",
            "not_when": "the only shared thing is a timestamp or a version bumped by release tooling",
        },
        {
            "move": "extract the shared knowledge into a module both import",
            "apply_when": "neither may import the other, and the coupling is a constant, a format or a rule they both encode",
            "not_when": "the coupling is only that a change to one usually prompts a look at the other",
        },
        {
            "move": "check the coupling is real before touching anything",
            "apply_when": "the pair is young, or the repository is small — the book's own caution that this flag is noise early",
            "not_when": "the pair has changed together across releases, which is not a coincidence",
        },
    ],
    "needless-export": [
        {
            "move": "drop the export",
            "apply_when": "nothing outside the module takes the name, and the module keeps using it itself",
            "not_when": "it is the module's reason to exist, and the consumer is in another repository",
        },
        {
            "move": "delete the declaration",
            "apply_when": "nothing inside the module uses it either",
            "not_when": "it is reachable only from tests, which is a decision to make deliberately rather than by deletion",
        },
        {
            "move": "keep it and add the caller",
            "apply_when": "the name is an interface the design has already decided on, and the caller is the next commit",
            "not_when": "'we might need it' is the whole reason; that is the interface growing ahead of its use",
        },
    ],
    "forwarded-parameter": [
