def detect_comment_repeats(comments: list[Comment], file: str) -> Iterator[Finding]:
    for comment in comments:
        if not comment.next_code_text:
            continue
        comment_words = content_words(comment.text)
        if len(comment_words) < REPEAT_MIN_WORDS:
            continue
        vocabulary = set(split_words(comment.next_code_text))
        matched = sum(1 for word in comment_words if lied_in(word, vocabulary))
        if matched < REPEAT_MIN_MATCHES or matched / len(comment_words) < REPEAT_RATIO:
            continue
        yield Finding(
            flag="comment-repeats-code",
            file=file,
            line=comment.start,
            symbol=comment.anchor,
            detail=f"{matched}/{len(comment_words)} content words already in the line below",
            measure=f"{matched}/{len(comment_words)}",
        )


def detect_implementation_narrative(comments: list[Comment], file: str) -> Iterator[Finding]:
    for comment in comments:
        if not comment.is_declaration:
            continue
        hits = sorted({word for word in content_words(comment.text) if word in IMPL_WORDS})
        if len(hits) < NARRATIVE_MIN_WORDS:
            continue
        yield Finding(
            flag="implementation-narrative-comment",
            file=file,
            line=comment.start,
            symbol=comment.anchor,
            detail="declaration comment narrates the mechanism: " + ", ".join(hits),
            measure=f"{len(hits)} impl words",
        )


def detect_shallow(symbols: list[Symbol], file: str) -> Iterator[Finding]:
    for symbol in symbols:
        if symbol.statements > SHALLOW_STATEMENTS or symbol.ccn > 1:
            continue
        yield Finding(
            flag="shallow-method",
            file=file,
            line=symbol.start,
            symbol=symbol.name,
            detail=f"{symbol.name}: {symbol.statements} statement, cyclomatic 1",
            measure=f"{symbol.statements} stmt",
        )


FORWARD = re.compile(r"^\s*(?:return\s+|await\s+|self\.|this\.)*?(?:(?:this|self)\.)?([A-Za-z_$][\w$]*)\.([A-Za-z_$][\w$]*)\s*\((.*)\)\s*;?$", re.DOTALL)


def detect_pass_through(symbols: list[Symbol], lines: list[str], file: str) -> Iterator[Finding]:
    for symbol in symbols:
        if symbol.statements != 1:
            continue
        _, body = body_statements(lines, symbol.start, symbol.end)
        if not body:
            continue
        match = FORWARD.match(body[0])
        if not match:
            continue
        receiver, callee, arguments = match.group(1), match.group(2), match.group(3)
        raw_args = [part.strip() for part in arguments.split(",") if part.strip()]
        same_name = callee == symbol.name
        same_signature = bool(symbol.params) and sorted(raw_args) == sorted(symbol.params)
        if not (same_name or same_signature):
            continue
        reason = "same name" if same_name else "identical signature"
        yield Finding(
            flag="pass-through",
            file=file,
            line=symbol.start,
            symbol=symbol.name,
            detail=f"{symbol.name} forwards to {receiver}.{callee} ({reason}), adding nothing",
            measure=f"args={len(raw_args)}",
        )


# --------------------------------------------------------------------------
# cross-file detectors
# --------------------------------------------------------------------------
#
# These read the index. Each one reports a *fact about a relationship* — a value
# known in two places, a shape declared twice, two files that move together, an
# interface wider than its use, a parameter nobody reads. The fix for all five
# is a design decision, so the finding carries the evidence and the repair menu
# carries the decisions; neither tries to prescribe the edit.


def detect_leaked_literal(index: Index) -> Iterator[Finding]:
    """A value that has to change in more than one module.

    The book's example: the banner background is one colour known in a central
    place, and the darker emphasis shade is written separately on the few pages
    that need it. Nothing in the code says the two must change together.
    Strings and numbers are treated alike — the fix differs, the flag does not —
    and the finding is filed once per value, not once per file, because the leak
    is one fact about a pair of modules: it survives until the value has an
    owner.
    """
    for literal, by_module in sorted(index.literals.items()):
        files = sorted(by_module)
        if len(files) < 2:
            continue
        kind, value = ("string", literal[2:]) if literal.startswith("s:") else ("number", literal[2:])
        # A string in two modules is almost always one decision written twice; a
        # number is often two decisions that happen to share the digits, so the
        # number's wording names the doubt rather than asserting the union.
        detail = (
            f"{kind} {value!r} is written in {len(files)} modules ({', '.join(files)}); changing it means changing all of them"
            if kind == "string"
            else f"number {value} is written in {len(files)} modules ({', '.join(files)}); check they are one decision, not two that share the digits"
        )
        yield Finding(
            flag="leaked-literal",
            file=files[0],
            line=by_module[files[0]][0],
            symbol=f"{kind}:{value}",
            detail=detail,
            measure=f"{len(files)} modules",
            files=tuple(files),
            key=f"leaked-literal:{literal}",
        )


def detect_leaked_shape(index: Index) -> Iterator[Finding]:
    """The same record — interface, type, class or dataclass — in more than one
    module, reported once per shape rather than once per pair.

    A reader and a writer each declaring the file layout is the book's example:
    both know the format, so every new field is a change in two places, and the
    pair has to be kept in step by hand. Four modules knowing it is one design
    decision written down four times, not six pairs, so records are clustered by
    shared fields and each cluster is reported once, listing the modules.

    Overlap is Jaccard over field names, so a record that merely *contains*
    another — `{a}` inside `{a, b, c}` — is not the same shape written twice,
    while `{a, b, c}` and `{a, b, c, d}` is: they know the same fields, in the
    same direction. Two modules related by an import are never merged, because a
    module that imports another's record is *reusing* the shape, which is the
    fix, not the leak.
    """
    records = index.records
    parent = list(range(len(records)))

    def find(node: int) -> int:
        while parent[node] != node:
            parent[node] = parent[parent[node]]
            node = parent[node]
        return node

    def overlaps(first: Record, second: Record) -> bool:
        if first.file == second.file:
            return False
        if first.file in index.importers.get(second.file, set()) or second.file in index.importers.get(first.file, set()):
            return False
        union = first.fields | second.fields
        return bool(union) and len(first.fields & second.fields) / len(union) >= SHAPE_OVERLAP

    for position, first in enumerate(records):
        for offset, second in enumerate(records[position + 1 :], start=position + 1):
            if overlaps(first, second) and find(position) != find(offset):
                parent[find(offset)] = find(position)

    clusters: dict[int, list[Record]] = {}
    for position, record in enumerate(records):
        clusters.setdefault(find(position), []).append(record)
    for members in clusters.values():
        files = sorted({record.file for record in members})
        if len(members) < 2 or len(files) < 2:
            continue
        members.sort(key=lambda record: (record.file, record.line))
        head = members[0]
        fields = set.intersection(*(set(record.fields) for record in members)) or set(head.fields)
        elsewhere = ", ".join(f"{record.file}:{record.line}" for record in members[1:])
        yield Finding(
            flag="leaked-shape",
            file=head.file,
            line=head.line,
            symbol="shape:" + ",".join(sorted(fields)),
            detail=f"{head.name} states a shape {len(files)} modules also state: {elsewhere}",
            measure=f"{len(fields)} fields, {len(files)} modules",
            files=tuple(files),
            key="leaked-shape:" + ",".join(sorted(fields)),
        )


def co_change_pairs(root: Path, since_days: int) -> dict[tuple[str, str], int]:
    """How many recent commits changed each pair of files together.

    A commit touching more than CO_CHANGE_MAX_COMMIT_FILES files is a sweep — a
    rename, a formatter, a licence header — and is dropped, or one afternoon of
    housekeeping would couple every file in the tree to every other.
    """
    if not (root / ".git").exists():
        return {}
    proc = subprocess.run(
        ["git", "log", f"--since={since_days}.days", "--name-only", "--pretty=format:%x00%H"],
        capture_output=True,
        text=True,
        cwd=root,
    )
    if proc.returncode != 0:
        return {}
    pairs: dict[tuple[str, str], int] = {}
    for chunk in proc.stdout.split("\x00")[1:]:
        names = sorted({line.strip() for line in chunk.splitlines() if line.strip()})
        if len(names) < 2 or len(names) > CO_CHANGE_MAX_COMMIT_FILES:
            continue
        for index, left in enumerate(names):
            for right in names[index + 1 :]:
                pairs[(left, right)] = pairs.get((left, right), 0) + 1
    return pairs


def detect_co_change(index: Index, root: Path) -> Iterator[Finding]:
    """Two files that keep changing together without either importing the other.

    That is a dependency the code does not declare: the reason they move
    together lives in neither of them. It is the one flag here that can be
    noise on a young repository — a feature written in one afternoon has every
    file in it changed together — so the threshold is CO_CHANGE_MIN commits
    inside a year, sweeps are dropped, and a pair that already imports across is
    skipped, because a declared dependency is not a hidden one.
    """
    known = {module.display for module in index.modules}
    for (left, right), count in sorted(co_change_pairs(root, CO_CHANGE_DAYS).items()):
        if count < CO_CHANGE_MIN or left not in known or right not in known:
            continue
        if left in index.importers.get(right, set()) or right in index.importers.get(left, set()):
            continue
        yield Finding(
            flag="co-change-without-import",
            file=left,
            line=1,
            symbol=right,
            detail=f"changed together in {count} of the last {CO_CHANGE_DAYS} days' commits, and neither imports the other",
            measure=f"{count} commits",
            files=(left, right),
            key=f"co-change-without-import:{left}:{right}",
        )


def detect_needless_export(index: Index) -> Iterator[Finding]:
    """An exported name that no importer ever takes.

    The interface is wider than the use. Every reader of the module has to
    consider the name, and every refactor has to keep it working, for callers
    that do not exist. A module with no importers at all is *not* reported:
    nothing has decided what its interface is yet, and a library's whole surface
    is legitimately unused inside the tree it ships from. A wildcard import
    silences the whole module, because `import *` takes everything.
    """
    for module in index.modules:
        if not index.importers.get(module.display):
            continue
        taken = index.imported_names.get(module.display, set())
        if "*" in taken:
            continue
        for symbol in module.symbols:
            if not symbol.exported or symbol.name in taken:
                continue
            yield Finding(
                flag="needless-export",
                file=module.display,
                line=symbol.line,
                symbol=symbol.name,
                detail=f"{symbol.name} is exported but no importer takes it; the module's interface is wider than its use",
                measure="0 importers",
            )


def detect_forwarded_parameter(index: Index) -> Iterator[Finding]:
    """A parameter that travels through a chain of methods that never read it.

    One hop is a pass-through and is already flagged as one. A chain is worse:
    each hop is an interface that would have to change if the parameter were
    removed, and none of them is doing anything with it. The finding is the
    chain, reported once at its head, with its length as the measure, because
    the number of hops is the number of interfaces and the length of the
    eventual fix.

    A local parameter declared by another name — `scratch = 1; m2(scratch)` —
    is deliberately not followed. The chain is built from the name travelling
    unchanged through the calls, which is the flag the book describes; a renamed
    hop is a different question and the tool would guess at it.
    """
    params_by_symbol: dict[tuple[str, int], list[str]] = {}
    callees_by_hop: dict[tuple[str, int, str], set[str]] = {}
    for module in index.modules:
        for symbol in module.symbols:
            forwarded = forwarded_params(symbol.body, symbol.params)
            params_by_symbol[(symbol.file, symbol.line)] = forwarded
            calls = calls_in(mask_strings(symbol.body))
            for param in forwarded:
                callees_by_hop[(symbol.file, symbol.line, param)] = {
                    call.callee for call in calls if any(argument.strip() == param for argument in call.args)
                }

    symbols_by_name: dict[str, list[Symbol]] = {}
    for module in index.modules:
        for symbol in module.symbols:
            symbols_by_name.setdefault(symbol.name, []).append(symbol)

    def successor(symbol: Symbol, param: str) -> Symbol | None:
        """The one method this parameter is forwarded to next, or None when the
        next hop is ambiguous (two same-named methods) or absent."""
        unique: dict[tuple[str, int], Symbol] = {}
        for callee in callees_by_hop.get((symbol.file, symbol.line, param), set()):
            for other in symbols_by_name.get(callee, []):
                if param in params_by_symbol.get((other.file, other.line), []):
                    unique[(other.file, other.line)] = other
        if len(unique) != 1:
            return None
        return next(iter(unique.values()))

    edges = [
        (symbol, param, successor(symbol, param))
        for module in index.modules
        for symbol in module.symbols
        for param in params_by_symbol.get((symbol.file, symbol.line), [])
    ]
    successors = {(symbol.file, symbol.line, param) for _, param, symbol in edges if symbol is not None}
    for head, param, next_symbol in sorted(edges, key=lambda edge: (edge[0].file, edge[0].line, edge[1])):
        if (head.file, head.line, param) in successors:
            continue  # a hop in someone else's chain; the head reports the whole of it
        chain = [head]
        hop = next_symbol
        while hop is not None and len(chain) < CHAIN_MAX_DEPTH:
            chain.append(hop)
            hop = successor(hop, param)
        if len(chain) < CHAIN_MIN_DEPTH:
            continue
        path = " → ".join(f"{symbol.file}:{symbol.name}" for symbol in chain)
        yield Finding(
            flag="forwarded-parameter",
            file=chain[0].file,
            line=chain[0].line,
            symbol=f"{chain[0].name}({param})",
            detail=f"{param} travels {len(chain)} methods that never read it: {path}",
            measure=f"{len(chain)} hops" + ("+" if len(chain) >= CHAIN_MAX_DEPTH else ""),
            files=tuple(dict.fromkeys(symbol.file for symbol in chain)),
        )


