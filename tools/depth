def load_baseline(path: Path) -> dict:
    if not path.is_file():
        die(
            f"no baseline at {path}\n"
            "Create one to accept the findings that are already there:\n"
            f"  depth --update-baseline --baseline {path}"
        )
    try:
        return json.loads(path.read_text())
    except json.JSONDecodeError as exc:
        die(f"{path} is not valid JSON: {exc}")


def write_baseline(path: Path, findings: list[Finding], score: int) -> None:
    payload = {
        "note": "Accepted depth findings. A finding not listed here fails the gate. Remove an entry when its fix lands; that is the trend.",
        "score": score,
        "findings": {finding.id: {"flag": finding.flag, "file": finding.file, "line": finding.line, "symbol": finding.symbol, "weight": finding.weight} for finding in findings},
    }
    path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")


