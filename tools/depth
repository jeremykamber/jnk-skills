# --------------------------------------------------------------------------
# report: opportunities, ranked, never gated
# --------------------------------------------------------------------------
#
# Tier C of DETECTORS.md. These are readings, not findings: none of them can
# fail a build, because each one needs a person to decide whether it is an
# opportunity or a deliberate design. They exist so that "is this getting deeper
# over months" has an answer in numbers rather than in an impression, which is
# the book's chapter 2.4 — complexity is incremental, invisible at one commit
# and obvious across eight.

DRIFT_REVISIONS = 8
DRIFT_FILES = 5
PURE_BLOCK_MIN_LINES = 3
ABSTRACTION_IMPLEMENTATIONS = 1
DEFAULT_TREND = ".depth-trend.jsonl"

TS_ABSTRACTION = re.compile(r"(?:export\s+)?(?:abstract\s+class|interface)\s+([A-Za-z_$][\w$]*)")
IMPLEMENTS = re.compile(r"\b(?:implements|extends)\s+([A-Za-z_$][\w$]*)")
PY_ABSTRACTION = re.compile(r"^\s*class\s+([A-Za-z_]\w*)\s*\(([^)]*\bABC\b[^)]*)\)", re.MULTILINE)
PY_BASES = re.compile(r"^\s*class\s+([A-Za-z_]\w*)\s*\(([^)]+)\)", re.MULTILINE)


@dataclass
class Opportunity:
    """A reading: a module, a symbol or a file, and the numbers behind it."""

    kind: str
    location: str
    subject: str
    measure: str
    note: str


@dataclass
class Survey:
    """Everything one run knows: the findings, the score, the index the readings
    are computed from, and the churn weights that rank both."""

    findings: list[Finding]
    score: int
    index: Index
    weights: dict[str, int]


def record_snapshot(path: Path, score: int, counts: dict[str, int]) -> None:
    """Append one dated line to the trend file.

    Append-only, one JSON object per line: two runs can write it without
    agreeing on anything but the format, and a corrupt line is skipped rather
    than losing the history around it.
    """
    snapshot = {
        "date": datetime.now(timezone.utc).strftime("%Y-%m-%d"),
        "score": score,
        "findings": sum(counts.values()),
        "flags": dict(sorted(counts.items())),
    }
    with path.open("a", encoding="utf-8") as handle:
        handle.write(json.dumps(snapshot) + "\n")


def read_trend(path: Path) -> list[dict]:
    if not path.is_file():
        return []
    rows: list[dict] = []
    for line in path.read_text(encoding="utf-8").splitlines():
        if not line.strip():
            continue
        try:
            rows.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    return rows


def git_revisions(root: Path, paths: list[str], count: int) -> list[str]:
    """The last `count` commits that touched any of these paths, oldest first."""
    proc = subprocess.run(
        ["git", "log", f"-n{count}", "--format=%H", "--", *paths],
        capture_output=True,
        text=True,
        cwd=root,
    )
    if proc.returncode != 0:
        return []
    return list(reversed([line.strip() for line in proc.stdout.splitlines() if line.strip()]))


def git_show(root: Path, revision: str, path: str) -> str | None:
    """A file's contents at a revision, or None when git does not have it."""
    proc = subprocess.run(["git", "show", f"{revision}:{path}"], capture_output=True, text=True, cwd=root)
    return proc.stdout if proc.returncode == 0 else None


def shallow_modules(index: Index, weights: dict[str, int]) -> list[Opportunity]:
    """Interface size against implementation size, per module.

    Interface = the public methods plus their parameters: what a caller has to
    hold in mind. Implementation = statements plus the branches over one, so a
    straight line counts as one and a decision counts as two. The ratio is the
    reading, and the book's own shape of a deep module is a small interface over
    a large implementation.

    Only the *public* half is measured, because the private half is not
    interface at all — it is the part that can be rewritten without telling
    anyone. A module with no public methods, or whose public methods have no
    statements, has no ratio and is skipped rather than reported as zero.
    """
    ranked: list[tuple[float, str, int, int, int]] = []
    for module in index.modules:
        exported = [symbol for symbol in module.symbols if symbol.public]
        interface = sum(1 + len(symbol.params) for symbol in exported)
        implementation = sum(symbol.statements + max(0, symbol.ccn - 1) for symbol in exported)
        if not exported or interface == 0 or implementation == 0:
            continue
        ranked.append((implementation / interface, module.display, interface, implementation, len(exported)))
    ranked.sort(key=lambda row: (row[0], -weights.get(row[1], 1), row[1]))
    return [
        Opportunity(
            kind="shallow-module",
            location=display,
            subject=f"{count} public",
            measure=f"interface {interface}, impl {implementation}",
            note=f"{ratio:.1f}x, churn {weights.get(display, 1)}",
        )
        for ratio, display, interface, implementation, count in ranked
    ]


def deletion_candidates(index: Index) -> list[Opportunity]:
    """A declared method nothing in the tree calls and no module imports.

    The strongest form of the book's "a name that has stopped carrying
    anything": the method is not on any path through the system, so it is either
    dead or it is an entry point. Entry points look exactly like this — a route
    handler, a CLI command, a page's default export — which is why this is a
    reading and not a finding. A default export is skipped outright, because the
    framework calls it by convention and no name in the tree ever will.

    A module that *is* imported is left to `needless-export`, which has the
    importers in hand and can tell an unused name from an unreferenced module.
    """
    called: set[str] = set()
    for module in index.modules:
        for symbol in module.symbols:
            for call in calls_in(mask_strings(symbol.body)):
                called.add(call.callee)
    rows: list[Opportunity] = []
    for module in index.modules:
        if index.importers.get(module.display):
            continue
        for symbol in module.symbols:
            if symbol.name in called:
                continue
            if "export default" in line_at(module.lines, symbol.line):
                continue
            rows.append(
                Opportunity(
                    kind="deletion-candidate",
                    location=f"{module.display}:{symbol.line}",
                    subject=symbol.name,
                    measure="0 callers, 0 importers",
                    note="dead code, or an entry point: check which",
                )
            )
    return rows


def single_implementation_abstractions(index: Index) -> list[Opportunity]:
    """An interface or abstract class with one implementation, or none.

    One implementation is an indirection: the interface buys nothing that the
    class itself would not, and chapter 4.6 calls the accumulation of such names
    classitis. Two implementations make a seam, one is a guess.

    Zero implementations is *not* reported. In TypeScript an interface used as a
    type never says `implements`, so a count of zero cannot tell a dead name
    from a structural one, and a table of every type alias in the tree is a
    table nobody reads.
    """
    declared: dict[str, str] = {}
    implemented: dict[str, set[tuple[str, int]]] = {}
    for module in index.modules:
        masked = "\n".join(module.masked)
        for match in TS_ABSTRACTION.finditer(masked):
            declared.setdefault(match.group(1), module.display)
        for match in PY_ABSTRACTION.finditer(masked):
            declared.setdefault(match.group(1), module.display)
        for match in IMPLEMENTS.finditer(masked):
            line = masked[: match.start()].count("\n") + 1
            implemented.setdefault(match.group(1), set()).add((module.display, line))
        for match in PY_BASES.finditer(masked):
            line = masked[: match.start()].count("\n") + 1
            for base in match.group(2).split(","):
                name = base.strip().split(".")[-1].strip()
                if name:
                    implemented.setdefault(name, set()).add((module.display, line))
    rows: list[Opportunity] = []
    for name, display in sorted(declared.items()):
        count = len(implemented.get(name, set()))
        if count != ABSTRACTION_IMPLEMENTATIONS:
            continue
        rows.append(
            Opportunity(
                kind="single-implementation",
                location=display,
                subject=name,
                measure=f"{count} implementation",
                note="an indirection until a second one exists",
            )
        )
    return rows


def pure_block_candidates(index: Index) -> list[Opportunity]:
    """Runs of statements inside a method that touch no instance state.

    The book's conjoined-methods signal: the method does two things, and the
    part that touches no instance state is the part that can leave. Only methods
    that touch instance state *somewhere* are read, because a method that never
    touches any is already a pure function and has nothing to split.

    A candidate, not a finding: the run may be pure and still belong to the
    method — it may need the arguments, or the sequence it sits in.
    """
    rows: list[Opportunity] = []
    for module in index.modules:
        for symbol in module.symbols:
            body = symbol.body.splitlines()
            if not any("this." in line or "self." in line for line in body):
                continue
            run_start = -1
            for offset, line in enumerate(body + [""]):
                pure = bool(line.strip()) and "this." not in line and "self." not in line
                if pure and run_start < 0:
                    run_start = offset
                elif not pure and run_start >= 0:
                    length = offset - run_start
                    if length >= PURE_BLOCK_MIN_LINES:
                        first = symbol.start + 1 + run_start
                        rows.append(
                            Opportunity(
                                kind="pure-block",
                                location=f"{module.display}:{first}",
                                subject=symbol.name,
                                measure=f"{length} statements",
                                note=f"lines {first}-{symbol.start + offset} touch no instance state",
                            )
                        )
                    run_start = -1
    return rows


def complexity_at(root: Path, revisions: list[str], displays: list[str], staging: Path) -> dict[str, list[tuple[str, int]]]:
    """Statements plus branches per file at each revision, oldest first.

    One lizard process per revision, not one per file: a reading that costs a
    subprocess per file would not be run at all. The arithmetic is the same as
    the shallow-module table's — statements plus the branches over one — so the
    two can be read against each other.
    """
    series: dict[str, list[tuple[str, int]]] = {display: [] for display in displays}
    for revision in revisions:
        stage = staging / revision
        present: list[str] = []
        for display in displays:
            text = git_show(root, revision, display)
            if text is None:
                continue
            target = stage / display
            target.parent.mkdir(parents=True, exist_ok=True)
            target.write_text(text, encoding="utf-8")
            present.append(display)
        if not present:
            continue
        totals: dict[str, int] = {}
        for row in run_lizard([stage.as_posix()]):
            name = row["file"].split(stage.as_posix() + "/", 1)[-1]
            totals[name] = totals.get(name, 0) + row["nloc"] + max(0, row["ccn"] - 1)
        for display in present:
            series[display].append((revision, totals.get(display, 0)))
    return series


def complexity_drift(root: Path, index: Index, weights: dict[str, int], revisions: int) -> list[Opportunity]:
    """Whether the busiest files are getting more complex.

    Samples the last `revisions` commits that touched any of the `DRIFT_FILES`
    busiest files and measures each of them at each commit. Growth in a file
    nobody touches costs nothing; growth in the file every change goes through
    is the number worth watching, which is why the sample is the busiest files
    rather than all of them.
    """
    if not (root / ".git").exists():
        return []
    busiest = sorted(index.modules, key=lambda module: (-weights.get(module.display, 1), module.display))[:DRIFT_FILES]
    displays = [module.display for module in busiest]
    if not displays:
        return []
    sampled = git_revisions(root, displays, revisions)
    if len(sampled) < 2:
        return []
    with tempfile.TemporaryDirectory() as tmp:
        series = complexity_at(root, sampled, displays, Path(tmp))
    ranked: list[tuple[int, str, int, int, int]] = []
    for display in displays:
        points = series.get(display, [])
        if len(points) < 2:
            continue
        first, last = points[0][1], points[-1][1]
        if first == 0 and last == 0:
            continue
        ranked.append((last - first, display, first, last, len(points)))
    ranked.sort(key=lambda row: (-row[0], row[1]))
    return [
        Opportunity(
            kind="complexity-drift",
            location=display,
            subject=f"{points} revisions",
            measure=f"{first} → {last} ({delta:+d})",
            note=f"churn {weights.get(display, 1)}",
        )
        for delta, display, first, last, points in ranked
    ]


def print_opportunities(sections: list[tuple[str, str, list[Opportunity]]], trend: list[dict], shown: int) -> None:
    for title, rule, rows in sections:
        print(f"\n{title}  ({len(rows)})")
        print(f"  {rule}")
        if not rows:
            print("  none")
            continue
        for row in rows[:shown]:
            print(f"  {row.measure:<26} {row.location:<44} {row.subject:<26} {row.note}")
        if len(rows) > shown:
            print(f"  ... {len(rows) - shown} more")
    if not trend:
        return
    first, last = trend[0], trend[-1]
    print(f"\ntrend  {len(trend)} snapshots  {first.get('date')} → {last.get('date')}")
    print(f"  findings {first.get('findings')} → {last.get('findings')}   score {first.get('score')} → {last.get('score')}")
    before, after = first.get("flags", {}), last.get("flags", {})
    for flag in sorted(set(before) | set(after)):
        if before.get(flag, 0) != after.get(flag, 0):
            print(f"  {flag:<34} {before.get(flag, 0):>4} → {after.get(flag, 0)}")


def report_main(args) -> int:
    """The readings, plus the trend. Never fails a build: nothing here has a
    threshold, because every one of them needs somebody to decide."""
    root = Path.cwd()
    result = survey(args)
    counts = dict(Counter(finding.flag for finding in result.findings).most_common())
    sections = [
        (
            "shallow modules",
            "interface = public methods + their parameters; implementation = statements + branches over one",
            shallow_modules(result.index, result.weights),
        ),
        (
            "deletion candidates",
            "declared, never called, in a module nobody imports: dead code or an entry point",
            deletion_candidates(result.index),
        ),
        (
            "single-implementation abstractions",
            "interfaces and abstract classes with one implementation or none",
            single_implementation_abstractions(result.index),
        ),
        (
            "pure blocks worth extracting",
            "runs of statements that touch no instance state, inside a method that does",
            pure_block_candidates(result.index),
        ),
        (
            "complexity drift",
            "the busiest files across their last revisions, in the shallow table's units",
            complexity_drift(root, result.index, result.weights, args.revisions),
        ),
    ]
    record_path = Path(args.record) if args.record else None
    if record_path is not None:
        record_snapshot(record_path, result.score, counts)
    # Reading is harmless, so an existing trend is shown without --record;
    # only writing needs to be asked for.
    trend = read_trend(record_path or Path(DEFAULT_TREND))

    if args.json:
        print(
            json.dumps(
                {
                    "findings": len(result.findings),
                    "score": result.score,
                    "counts": counts,
                    "sections": {title: [asdict(row) for row in rows] for title, _, rows in sections},
                    "trend": trend,
                },
                indent=2,
            )
        )
        return 0
    print(f"depth report  findings {len(result.findings)}  score {result.score}")
    print_opportunities(sections, trend, args.top)
    if not trend:
        print(f"\n  no trend yet: --record keeps one ({DEFAULT_TREND} by default).")
    return 0


def moves_for(flag: str) -> list[dict[str, str]]:
    return REPAIRS.get(flag, [])


def report_text(findings: list[Finding], score: int, baseline: dict | None, shown: int) -> None:
    counts = Counter(finding.flag for finding in findings)
    print(f"depth  findings {len(findings)}  score {score}  (score = sum of per-file churn weights)")
    if counts:
        for flag, count in sorted(counts.items()):
            print(f"  {flag:<34} {count:>3}   fix: {' | '.join(move['move'] for move in moves_for(flag))}")
    print()
    if not findings:
        print("  no findings in scope")
        return
    print(f"  {'FLAG':<34} {'SYMBOL':<30} {'LOCATION':<28} MEASURE")
    print(f"  {'-' * 34} {'-' * 30} {'-' * 28} {'-' * 12}")
    # Sampled per flag rather than overall. One flag can carry hundreds of
    # findings — a tree that never centralised its strings produces a
    # `leaked-literal` for every UI label — and a flat top-N then shows nothing
    # else, hiding the three-finding flag that is the day's work.
    per_flag = max(1, shown // max(1, len(counts)))
    hidden = 0
    for flag in sorted(counts):
        rows = [finding for finding in findings if finding.flag == flag]
        for finding in rows[:per_flag]:
            print(f"  {finding.flag:<34} {finding.symbol[:30]:<30} {finding.location:<28} {finding.measure}")
        if len(rows) > per_flag:
            hidden += len(rows) - per_flag
            print(f"  {'':<34} ... {len(rows) - per_flag} more {flag}")
    if hidden:
        print(f"\n  {hidden} rows hidden: --top sets rows per flag, not rows overall")

    if baseline is None:
        print("\n  report only: no --baseline, so this run cannot fail. Add one to ratchet.")
        return
    known = baseline.get("findings", {})
    new = [finding for finding in findings if finding.id not in known]
    paid = [key for key in known if key not in {finding.id for finding in findings}]
    print(f"\n  ratchet  new {len(new)}  paid {len(paid)}  baseline score {baseline.get('score', 0)}  now {score}")
    for finding in new:
        print(f"    NEW  {finding.flag}  {finding.location}  {finding.symbol}")
    for key in paid:
        print(f"    PAID {key}")
    if paid:
        print("  a paid finding is debt repaid: run --update-baseline to record it.")


def explain(flag: str) -> None:
    moves = moves_for(flag)
    if not moves:
        die(f"unknown flag '{flag}'. Known: {', '.join(sorted(REPAIRS))}")
    print(f"{flag}\n")
    for index, move in enumerate(moves, start=1):
        print(f"  {index}. {move['move']}")
        print(f"     apply when: {move['apply_when']}")
        print(f"     not when:   {move['not_when']}\n")
    print("Choosing among these is the whole job. A move that requires new behavior is a design change to report, not to make.")


def die(message: str) -> NoReturn:
    print(message, file=sys.stderr)
    raise SystemExit(2)


def main(argv: list[str] | None = None) -> int:
    arguments = list(sys.argv[1:] if argv is None else argv)
    command = "report" if arguments and arguments[0] == "report" else "detect"
    if command == "report":
        arguments = arguments[1:]
    parser = argparse.ArgumentParser(prog="depth", description=__doc__.split("Usage:")[0], formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("paths", nargs="*", help="files or directories (default: ./src, else .)")
    parser.add_argument("--baseline", default=None, help=f"ratchet file (default when updating: {DEFAULT_BASELINE})")
    parser.add_argument("--update-baseline", action="store_true", help="write the current findings as the accepted set")
    parser.add_argument("--changed", action="store_true", help="only findings in files changed against --base")
    parser.add_argument("--base", default=None, help="git ref to diff against (default: origin/HEAD, main, master)")
    parser.add_argument("--include-tests", action="store_true", help="score test files too")
    parser.add_argument("--json", action="store_true", help="machine-readable output")
    parser.add_argument("--top", type=int, default=40, help="rows to show per flag in the text report")
    parser.add_argument("--explain", metavar="FLAG", default=None, help="print the repair menu for one flag")
    parser.add_argument("--revisions", type=int, default=DRIFT_REVISIONS, help=f"revisions to sample for the drift reading (report only, default {DRIFT_REVISIONS})")
    parser.add_argument(
        "--record",
        nargs="?",
        const=DEFAULT_TREND,
        default=None,
        help=f"append a dated snapshot to this file (report only, default {DEFAULT_TREND})",
    )
    args = parser.parse_args(arguments)

    if args.explain:
        explain(args.explain)
        return 0

    if command == "report":
        return report_main(args)

    findings, score = collect(args)
    findings = disambiguate(findings)

    if args.update_baseline:
        path = Path(args.baseline or DEFAULT_BASELINE)
        write_baseline(path, findings, score)
        print(f"depth  accepted {len(findings)} findings into {path}  score {score}")
        return 0

    baseline = load_baseline(Path(args.baseline)) if args.baseline else None

    if args.json:
        payload = {
            "score": score,
            "count": len(findings),
            "findings": [
                {**asdict(finding), "id": finding.id, "location": finding.location, "moves": moves_for(finding.flag)} for finding in findings
            ],
        }
        if baseline is not None:
            known = baseline.get("findings", {})
            payload["new"] = [finding.id for finding in findings if finding.id not in known]
            payload["paid"] = [key for key in known if key not in {finding.id for finding in findings}]
        print(json.dumps(payload, indent=2))
    else:
        report_text(findings, score, baseline, args.top)

    if baseline is None:
        return 0
    known = baseline.get("findings", {})
    if any(finding.id not in known for finding in findings):
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
