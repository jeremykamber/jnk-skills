def iter_source_files(paths: list[str], include_tests: bool) -> Iterator[Path]:
    for raw in paths:
        path = Path(raw)
        if path.is_file():
            yield path
            continue
        for candidate in sorted(path.rglob("*")):
            if not candidate.is_file() or candidate.suffix not in SOURCE_EXT:
                continue
            text = candidate.as_posix()
            if BUILD_DIRS.search(text) or GENERATED.search(text):
                continue
            if not include_tests and TEST_FILES.search(text):
                continue
            yield candidate


def git_changed(base: str | None, root: Path) -> set[str]:
    ref = base
    if not ref:
        for candidate in BASE_CANDIDATES:
            probe = subprocess.run(["git", "rev-parse", "--verify", "--quiet", candidate], capture_output=True, text=True, cwd=root)
            if probe.returncode == 0:
                ref = candidate
                break
    if not ref:
        die("--changed was requested but no base ref could be resolved. Pass --base <ref>.")
    changed: set[str] = set()
    for cmd in (["git", "diff", "--name-only", "--diff-filter=ACMR", ref], ["git", "ls-files", "--others", "--exclude-standard"]):
        proc = subprocess.run(cmd, capture_output=True, text=True, cwd=root)
        if proc.returncode != 0:
            die(f"{' '.join(cmd)} failed:\n{proc.stderr.strip()}")
        for line in proc.stdout.splitlines():
            if line.strip():
                changed.add(os.path.realpath(root / line.strip()))
    return changed


def survey(args) -> Survey:
    """Everything one run knows: the findings, the score, and the index the
    readings are computed from. `collect` is the gate's view of it."""
    root = Path.cwd()
    paths = args.paths or (["src"] if Path("src").is_dir() else ["."])
    files = [path for path in iter_source_files(paths, args.include_tests)]
    changed = git_changed(args.base, root) if args.changed else None
    weights = churn_weights(root)

    scoped: list[tuple[Path, str]] = []
    for path in files:
        if changed is not None and os.path.realpath(path) not in changed:
            continue
        try:
            scoped.append((path, path.read_text()))
        except (UnicodeDecodeError, OSError):
            continue

    # One lizard process for the tree, not one per file. A gate that runs on
    # every change cannot afford a subprocess per file, and lizard takes many
    # paths in one call. Chunked because a large tree will otherwise exceed the
    # command line limit, and a gate that dies on a big tree is a dead gate.
    rows_by_file: dict[str, list[dict]] = {}
    displays = [path.as_posix() for path, _ in scoped]
    for start in range(0, len(displays), 200):
        for row in run_lizard(displays[start : start + 200]):
            rows_by_file.setdefault(row["file"].lstrip("./"), []).append(row)

    findings: list[Finding] = []
    modules: list[Module] = []
    for path, text in scoped:
        language = language_of(path)
        display = path.as_posix()
        lines = text.splitlines()
        comments, nest_by_line = scan_comments(text, language)
        code = comment_stripped(lines, language)
        # Structure is read from the masked code: strings blanked so a brace or
        # a comma inside one cannot move a block boundary, comments removed so a
        # commented-out interface is not a declaration.
        masked = mask_strings("\n".join(code)).split("\n")
        symbols = symbols_in(rows_by_file.get(display.lstrip("./"), []), lines, code, language, display, nest_by_line)
        modules.append(
            Module(
                path=path,
                display=display,
                language=language,
                lines=lines,
                masked=masked,
                code=code,
                nest=nest_by_line,
                comments=comments,
                symbols=symbols,
                records=records_in(masked, lines, language, display),
                literals=literals_in(code, masked),
                imports=imports_in(code, language),
            )
        )
        findings.extend(detect_comment_repeats(comments, display))
        findings.extend(detect_implementation_narrative(comments, display))
        shallow = list(detect_shallow(symbols, display))
        through = list(detect_pass_through(symbols, lines, display))
        shadowed = {(finding.symbol) for finding in through}
        # A one-statement forwarder is one finding, not two: the pass-through is
        # the more specific description of why it is shallow.
        findings.extend(finding for finding in shallow if finding.symbol not in shadowed)
        findings.extend(through)

    index = build_index(modules, root)
    findings.extend(detect_leaked_literal(index))
    findings.extend(detect_leaked_shape(index))
    findings.extend(detect_co_change(index, root))
    findings.extend(detect_needless_export(index))
    findings.extend(detect_forwarded_parameter(index))

    weight = 0
    for finding in findings:
        # A finding about a pair of files is worth what the busier of the two is
        # worth: the cost is paid wherever either end of the relationship is
        # edited.
        reach = max(weights.get(name, 1) for name in (finding.file, *finding.files))
        finding.weight = min(50, reach)
        weight += finding.weight
    findings.sort(key=lambda f: (f.file, f.line, f.flag))
    return Survey(findings=findings, score=weight, index=index, weights=weights)


def collect(args) -> tuple[list[Finding], int]:
    result = survey(args)
    return result.findings, result.score


def disambiguate(findings: list[Finding]) -> list[Finding]:
    seen: dict[str, int] = {}
    for finding in findings:
        key = finding.id
        seen[key] = seen.get(key, 0) + 1
        if seen[key] > 1:
            finding.symbol = f"{finding.symbol}:{finding.line}"
    return findings


