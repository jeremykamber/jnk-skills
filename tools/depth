            "move": "remove the parameter and let each hop get what it needs",
            "apply_when": "the parameter is available at the point of use, or the hop that needs it can look it up",
            "not_when": "passing it is what keeps the hop from depending on the layer that knows it",
        },
        {
            "move": "collapse the chain",
            "apply_when": "the hops add nothing but the trip: expose the deep module and delete the middle methods",
            "not_when": "each hop owns policy — a check, a default, a translation — that the parameter passes through",
        },
        {
            "move": "keep the chain and record why it exists",
            "apply_when": "the hops are a boundary the design must not cross, and the parameter is the toll",
            "not_when": "the only answer to 'why does this hop exist' is 'it always has'",
        },
    ],
}


@dataclass
class Finding:
    flag: str
    file: str
    line: int
    symbol: str
    detail: str
    measure: str
    weight: int = 1
    files: tuple[str, ...] = ()
    key: str = ""

    @property
    def id(self) -> str:
        """What the ratchet remembers.

        Usually the flag, the file and the symbol. A finding about a
        *relationship* sets `key` instead, because its file is whichever module
        happens to sort first, and that moves whenever the code moves: on the
        first real pull request this tool was run against, a pure refactor that
        moved a duplicated string from one file into a new one flipped the
        finding's identity and reported sixty-one findings as new. An id that a
        refactor can change is an id that teaches the team to ignore the gate.
        """
        return self.key or f"{self.flag}:{self.file}:{self.symbol}"

    @property
    def location(self) -> str:
        return f"{self.file}:{self.line}"


@dataclass
class Comment:
    """One contiguous run of comment lines, and the code it attaches to."""

    start: int
    end: int
    text: str
    next_code_line: int
    next_code_text: str
    is_declaration: bool

    @property
    def anchor(self) -> str:
        digest = hashlib.sha1(" ".join(self.text.split()).encode()).hexdigest()[:8]
        return f"c{digest}"


# --------------------------------------------------------------------------
# words
# --------------------------------------------------------------------------


def split_words(value: str) -> list[str]:
    """Lowercase words, split on case boundaries, underscores and punctuation.

    getNormalizedResourceNames -> [get, normalized, resource, names]
    TEXT_HORIZONTAL_PADDING    -> [text, horizontal, padding]
    """
    words: list[str] = []
    for chunk in re.split(r"[^0-9A-Za-z]+", value):
        if not chunk:
            continue
        words.extend(part.lower() for part in re.findall(r"[A-Z]+(?![a-z])|[A-Z][a-z0-9]*|[a-z0-9]+", chunk))
    return words


def content_words(text: str) -> list[str]:
    return [word for word in split_words(text) if len(word) >= 2 and word not in STOPWORDS]


def lied_in(word: str, vocabulary: set[str]) -> bool:
    """Word membership with prefix agreement, so name/names and line/lines match."""
    if word in vocabulary:
        return True
    if len(word) < 4:
        return False
    return any(len(v) >= 4 and (word.startswith(v) or v.startswith(word)) for v in vocabulary)


# --------------------------------------------------------------------------
# source scanning
# --------------------------------------------------------------------------


def language_of(path: Path) -> str:
    return "py" if path.suffix == ".py" else "js"


def scan_comments(text: str, language: str) -> tuple[list[Comment], dict[int, int]]:
    """Contiguous comment runs, each with the code line it attaches to, plus the
    nesting depth in front of every line.

    A blank line detaches: editorial commentary above a fixture, or a licence
    header above a class, is not a comment *about* the line below it. Strings
    are tracked so that `//` inside a URL and `#` inside a docstring are not
    mistaken for comments; Python docstrings are comments here, because in
    Python they are where a module's interface is written.

    `nest` is the brace depth for JS/TS and the indentation depth for Python. It
    is what separates an interface — a module or a member — from an
    implementation, and both the comment check and the function checks need it.
    """
    lines = text.splitlines()
    blocks: list[Comment] = []
    nest_by_line: dict[int, int] = {}
    pending: list[str] = []
    pending_start = 0
    pending_docstring = False
    block_end: str | None = None
    quote: str | None = None
    nest = 0
    previous_text = ""
    previous_line = 0
    for index, raw in enumerate(lines, start=1):
        # For Python the depth of a line is its own indentation; for JS/TS it is
        # the brace depth in front of the line. `nest` tracks the running value
        # either way, which is what the comment attachment needs.
        nest_by_line[index] = (len(raw) - len(raw.lstrip())) // 4 if language == "py" else nest
        code, comment, block_end, quote, entered, touched = _split_line(raw, language, block_end, quote)
        if comment:
            if not pending:
                pending_start = index
                pending_docstring = entered
            pending.append(comment)
        if code.strip():
            if pending:
                if language == "py" and pending_docstring:
                    blocks.append(_make_block(pending, pending_start, previous_line, previous_text, nest, language))
                else:
                    blocks.append(_make_block(pending, pending_start, index, code.strip(), nest, language))
                pending = []
        elif not touched and pending and block_end is None:
            blocks.append(_make_block(pending, pending_start, index, "", nest, language))
            pending = []
        if code.strip():
            nest = _nest_after(nest, code, language, raw)
            previous_text, previous_line = code.strip(), index
    if pending:
        blocks.append(_make_block(pending, pending_start, previous_line, previous_text, nest, language))
    return blocks, nest_by_line


def comment_stripped(lines: list[str], language: str) -> list[str]:
    """The code half of every line, with comment text removed.

    Literals and structure are read from this rather than the raw text, so a
    literal quoted in a comment, or a brace in a commented-out block, is not a
    finding. It reuses `_split_line`, because the scanner that knows a `//` in a
    URL is not a comment is the only one that should decide what a comment is.
    """
    out: list[str] = []
    block_end: str | None = None
    quote: str | None = None
    for line in lines:
        code, _, block_end, quote, _, _ = _split_line(line, language, block_end, quote)
        out.append(code)
    return out


def _nest_after(nest: int, code: str, language: str, raw: str) -> int:
    if language == "py":
        indent = len(raw) - len(raw.lstrip())
        return indent // 4
    return max(0, nest + code.count("{") - code.count("}"))


def _split_line(
    line: str, language: str, block_end: str | None, quote: str | None
) -> tuple[str, str, str | None, str | None, bool, bool]:
    """Return (code, comment, block_end, quote, entered, touched) for one line.

    `entered` marks the line that opened a comment region; `touched` marks every
    line that contained any part of one, including the line that closes a block
    comment and carries no text of its own. Without `touched`, a closing `*/`
    line looks like a blank line and detaches the block above it.
    """
    code: list[str] = []
    comment: list[str] = []
    entered = False
    touched = block_end is not None
    index = 0
    limit = len(line)
    while index < limit:
        char = line[index]
        pair = line[index : index + 2]
        if block_end is not None:
            if line.startswith(block_end, index):
                index += len(block_end)
                block_end = None
                continue
            comment.append(char)
            index += 1
            continue
        if quote is not None:
            code.append(char)
            if char == "\\":
                if index + 1 < limit:
                    code.append(line[index + 1])
                index += 2
                continue
            if char == quote:
                quote = None
            index += 1
            continue
        if language == "py" and line.startswith(('"""', "'''"), index) and "".join(code).strip() == "":
            entered = touched = True
            block_end = line[index : index + 3]
            index += 3
            continue
        if char in "\"'`":
            quote = char
            code.append(char)
            index += 1
            continue
        if pair == "/*":
            entered = touched = True
            block_end = "*/"
            index += 2
            continue
        if pair == "//":
            touched = True
            comment.append(line[index + 2 :])
            break
        if language == "py" and char == "#":
            touched = True
            comment.append(line[index + 1 :])
            break
        code.append(char)
        index += 1
    joined = "".join(comment).strip()
    return "".join(code), joined, block_end, quote, entered, touched


DECLARATION = re.compile(
    r"^\s*(?:(?:export|default|public|private|protected|static|readonly|abstract|async|declare|final)\s+)*"
    r"(?:function|class|interface|type|enum|const|let|var|def|struct)\b"
    r"|^\s*(?:(?:export|default|public|private|protected|static|readonly|abstract|async|get|set|override|final)\s+)*"
    r"[A-Za-z_$][\w$]*\s*[(<][^;{}]*[{:]\s*$"
)
CONTROL = re.compile(r"^\s*(?:if|for|while|switch|else|catch|try|finally|do|elif|except|return|throw|await|yield)\b")
MAX_INTERFACE_NEST = 1

KEYWORD_DECL = re.compile(r"(?:\w+\s+)*?(?:function|def|class)\s+([A-Za-z_$][\w$]*)")
BINDING_DECL = re.compile(r"(?:(?:export|default|declare)\s+)*(?:const|let|var)\s+([A-Za-z_$][\w$]*)")
MEMBER_DECL = re.compile(
    r"(?:(?:public|private|protected|static|readonly|async|get|set|override|final)\s+)*([A-Za-z_$][\w$]*)\s*[(<]"
)
ASSIGNMENT_DECL = re.compile(r"([A-Za-z_$][\w$]*)\s*=")


def declares(line: str, name: str) -> bool:
    """True when this line is where `name` is defined.

    lizard reports an arrow handed to a call (`usePersonaStore((s) => s.batches)`)
    and a JSX binding (`const content = (…)`) as functions, and it is not wrong
    — they are functions. They are not *modules*, and the shallow-module flag is
    about a module's interface. Checking the declaration is what tells the two
    apart, since a name taken from a call site does not name what the line binds.
    """
    if not name or name == "(anonymous)":
        return False
    stripped = line.strip()
    for pattern in (KEYWORD_DECL, BINDING_DECL, MEMBER_DECL, ASSIGNMENT_DECL):
        match = pattern.match(stripped)
        if match:
            return match.group(1) == name
    return False


# `symbols_in` is the one place a lizard row becomes a method: it rejects the
# anonymous lambdas and hook callbacks lizard reports, and rejects anything
# nested deeper than a member, so every detector downstream can trust what it
# gets.


def _make_block(
    pending: list[str],
    start: int,
    next_line: int,
    next_text: str,
    nest: int,
    language: str,
) -> Comment:
    text = "\n".join(pending)
    # Tag words repeat the parameter name by design: @param numThreads is not a
    # comment that repeats the code, it is a documented argument.
    text = re.sub(r"@(param|returns?|throws?|type|arg)\s+\S+", "", text)
    text = re.sub(r":(param|returns?|type|raises)\s*(?:\w+\s*)?:", "", text)
    text = re.sub(r"^\s*(Args|Arguments|Returns|Raises|Yields):\s*$", "", text, flags=re.MULTILINE)
    is_declaration = (
        bool(next_text)
        and nest <= MAX_INTERFACE_NEST
        and bool(DECLARATION.match(next_text))
        and not CONTROL.match(next_text)
    )
    return Comment(start, start + len(pending) - 1, text, next_line, next_text, is_declaration)


