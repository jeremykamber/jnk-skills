# churn
# --------------------------------------------------------------------------


def churn_weights(root: Path) -> dict[str, int]:
    """Commits per file over CHURN_DAYS. Leaves are weighted by the time spent
    on them: complexity in a file nobody touches is complexity nobody pays for.

    C = sum(c_p * t_p), the book's own formula, with t_p read off git history.
    Not a gate input — a ranking, so the report's first line is the file the
    team is actually changing.
    """
    if not (root / ".git").exists():
        return {}
    proc = subprocess.run(
        ["git", "log", f"--since={CHURN_DAYS}.days", "--numstat", "--pretty=format:", "--", "."],
        capture_output=True,
        text=True,
        cwd=root,
    )
    if proc.returncode != 0:
        return {}
    weights: dict[str, int] = {}
    for line in proc.stdout.splitlines():
        parts = line.split("\t")
        if len(parts) != 3 or not parts[2]:
            continue
        path = parts[2].strip()
        if path.endswith("=>"):  # rename line, ignore
            continue
        weights[path] = weights.get(path, 0) + 1
    return weights


